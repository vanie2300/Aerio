    <Content Include="Assets\4578.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\ddg.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\startpage.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\brave.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\searxng.png" CopyToOutputDirectory="PreserveNewest" />
