<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Aerio</AssemblyName>
    <AssemblyTitle>Aerio</AssemblyTitle>
    <Product>Aerio</Product>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>UI\Assets\Aerio.ico</ApplicationIcon>
    <Version>1.4.0</Version>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditLevel>high</NuGetAuditLevel>
    <!--
      Analyzer policy: the security rule categories (CA53xx, CA21xx, CA30xx) and
      correctness rules stay on. The rules below are either style/perf churn that
      does not affect behaviour, or a documented false positive for this app.
      CA1001  MainWindow disposes its IDisposable fields explicitly in
              MainWindow.Shutdown.cs rather than implementing IDisposable.
      CA1305  Culture on interpolated ToString - values here are machine data.
      CA1310  StringComparison - mechanical cleanup, tracked separately.
      CA1822  "make member static" - partial-class UI members.
      CA1859  concrete return types in UI builder helpers.
      CA1861  constant arrays as arguments.
      CA1866  char overloads of char.Is* helpers.
    -->
    <NoWarn>$(NoWarn);CA1001;CA1305;CA1310;CA1822;CA1859;CA1861;CA1866</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="TabloidBrowser.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TabloidBrowser.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiquidGlassEngineering.Wpf" Version="1.0.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="UI\App.xaml" SubType="Designer" />
    <Page Include="UI\MainWindow.xaml" SubType="Designer" />
    <Page Include="UI\Controls\*.xaml" />
    <Page Include="UI\Styles\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="UI\Assets\Aerio.png" Link="Assets\Aerio.png" />
    <Resource Include="UI\Assets\Aerio.ico" Link="Assets\Aerio.ico" />
    <Content Include="UI\Assets\Aerio.ico" Link="Assets\Aerio.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="UI\Assets\4578.jpg" Link="Assets\4578.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="UI\Assets\ddg.png" Link="Assets\ddg.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="UI\Assets\startpage.png" Link="Assets\startpage.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="UI\Assets\brave.png" Link="Assets\brave.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="UI\Assets\searxng.png" Link="Assets\searxng.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="UI\readability.min.js" Link="readability.min.js" />
    <Content Include="UI\Assets\Fonts\PureMechanic.ttf" Link="Assets\Fonts\PureMechanic.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
