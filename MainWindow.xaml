<Window x:Class="TabloidBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:TabloidBrowser"
        Title="Tabloid Browser"
        Width="1280"
        Height="760"
        MinWidth="940"
        MinHeight="540"
        Background="{DynamicResource AppBg}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <SolidColorBrush x:Key="AppBg" Color="#0D0D0D" />
    <SolidColorBrush x:Key="ChromeBg" Color="#141414" />
    <SolidColorBrush x:Key="ChromeAlt" Color="#1A1A1A" />
    <SolidColorBrush x:Key="InputBg" Color="#101010" />
    <SolidColorBrush x:Key="TitleBg" Color="#0A0A0A" />
    <SolidColorBrush x:Key="ButtonBg" Color="#181818" />
    <SolidColorBrush x:Key="ButtonHover" Color="#202020" />
    <SolidColorBrush x:Key="ButtonPressed" Color="#262626" />
    <SolidColorBrush x:Key="Stroke" Color="#2F2F2F" />
    <SolidColorBrush x:Key="SubtleStroke" Color="#1F1F1F" />
    <SolidColorBrush x:Key="Text" Color="#EFEFEF" />
    <SolidColorBrush x:Key="Muted" Color="#8E8E8E" />
    <SolidColorBrush x:Key="Cyan" Color="#724DDF" />
    <SolidColorBrush x:Key="Lime" Color="#6A9955" />
    <SolidColorBrush x:Key="Pink" Color="#C586C0" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#5A5A5A" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#7A7A7A" />
    <SolidColorBrush x:Key="ScrollThumbPressed" Color="#999999" />
    <RadialGradientBrush x:Key="StartBg"
                         Center="0.5,0.34"
                         GradientOrigin="0.5,0.34"
                         RadiusX="0.78"
                         RadiusY="0.7">
      <GradientStop Color="#0B0E17" Offset="0" />
      <GradientStop Color="#090C14" Offset="0.55" />
      <GradientStop Color="#07080C" Offset="1" />
    </RadialGradientBrush>

    <DropShadowEffect x:Key="TabGlow" ShadowDepth="0" BlurRadius="12" Opacity="0.3" Color="#724DDF" />
    <DropShadowEffect x:Key="ButtonGlow" ShadowDepth="0" BlurRadius="8" Opacity="0.25" Color="#724DDF" />
    <DropShadowEffect x:Key="PopupShadow" ShadowDepth="0" BlurRadius="24" Opacity="0.35" Color="#000000" />

    <CircleEase x:Key="SpringEase" EasingMode="EaseOut" />
    <QuadraticEase x:Key="SmoothEase" EasingMode="EaseInOut" />
    <CubicEase x:Key="CubicEaseOut" EasingMode="EaseOut" />
    <QuinticEase x:Key="BounceEase" EasingMode="EaseOut" />

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Background" Value="{DynamicResource ButtonBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="RenderTransform">
        <Setter.Value>
          <ScaleTransform ScaleX="1" ScaleY="1" />
        </Setter.Value>
      </Setter>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <Grid>
                <Border x:Name="HoverOverlay"
                        Background="{DynamicResource ButtonHover}"
                        CornerRadius="6"
                        Opacity="0" />
                <Border x:Name="PressedOverlay"
                        Background="{DynamicResource ButtonPressed}"
                        CornerRadius="6"
                        Opacity="0" />
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Cyan}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1" Duration="0:0:0.1" />
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                       To="1.05" Duration="0:0:0.12"
                                       EasingFunction="{StaticResource SpringEase}" />
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                       To="1.05" Duration="0:0:0.12"
                                       EasingFunction="{StaticResource SpringEase}" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0" Duration="0:0:0.2" />
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                       To="1" Duration="0:0:0.2"
                                       EasingFunction="{StaticResource SpringEase}" />
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                       To="1" Duration="0:0:0.2"
                                       EasingFunction="{StaticResource SpringEase}" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressedOverlay"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1" Duration="0:0:0.05" />
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                       To="0.95" Duration="0:0:0.05" />
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                       To="0.95" Duration="0:0:0.05" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressedOverlay"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0" Duration="0:0:0.2" />
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                       To="1" Duration="0:0:0.15" />
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                       To="1" Duration="0:0:0.15" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.32" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Background" Value="{DynamicResource ButtonBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="RenderTransform">
        <Setter.Value>
          <ScaleTransform ScaleX="1" ScaleY="1" />
        </Setter.Value>
      </Setter>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <Grid>
                <Border x:Name="HoverOverlay"
                        Background="{DynamicResource ButtonHover}"
                        CornerRadius="6"
                        Opacity="0" />
                <Border x:Name="CheckedOverlay"
                        Background="{DynamicResource ButtonPressed}"
                        CornerRadius="6"
                        Opacity="0" />
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Margin="{TemplateBinding Padding}" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Cyan}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1" Duration="0:0:0.1" />
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                       To="1.04" Duration="0:0:0.12"
                                       EasingFunction="{StaticResource SpringEase}" />
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                       To="1.04" Duration="0:0:0.12"
                                       EasingFunction="{StaticResource SpringEase}" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0" Duration="0:0:0.2" />
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                       To="1" Duration="0:0:0.2"
                                       EasingFunction="{StaticResource SpringEase}" />
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                       To="1" Duration="0:0:0.2"
                                       EasingFunction="{StaticResource SpringEase}" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Cyan}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="CheckedOverlay"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1" Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="CheckedOverlay"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0" Duration="0:0:0.2" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="28" />
    </Style>

    <Style x:Key="MicroButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Height" Value="26" />
      <Setter Property="MinWidth" Value="38" />
      <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style x:Key="TitleBarButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="41" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="CloseTitleBarButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}">
              <Grid>
                <Border x:Name="HoverOverlay"
                        CornerRadius="0"
                        Opacity="0">
                  <Border.Background>
                    <SolidColorBrush Color="#C42B1C" />
                  </Border.Background>
                </Border>
                <Border x:Name="PressedOverlay"
                        CornerRadius="0"
                        Opacity="0">
                  <Border.Background>
                    <SolidColorBrush Color="#A4261D" />
                  </Border.Background>
                </Border>
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1" Duration="0:0:0.1" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0" Duration="0:0:0.15" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressedOverlay"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1" Duration="0:0:0.05" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressedOverlay"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0" Duration="0:0:0.15" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Background" Value="{DynamicResource ChromeBg}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonHover}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonPressed}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Background" Value="{DynamicResource InputBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,0,30,0" />
      <Setter Property="MaxDropDownHeight" Value="220" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ToggleButton"
                            Focusable="False"
                            ClickMode="Press"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                      <Grid>
                        <Path Data="M 0 0 L 4 4 L 8 0 Z"
                              Fill="{DynamicResource Muted}"
                              Width="8"
                              Height="4"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Cyan}" />
                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ChromeBg}" />
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonPressed}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>

              <ContentPresenter x:Name="ContentSite"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left" />

              <Popup x:Name="Popup"
                     Placement="Bottom"
                     AllowsTransparency="True"
                     Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Background="{DynamicResource ChromeBg}"
                        BorderBrush="{DynamicResource Stroke}"
                        BorderThickness="1">
                  <ScrollViewer CanContentScroll="True">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BrowserContextMenuStyle" TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource ChromeBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ItemsPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BrowserMenuItemStyle" TargetType="MenuItem">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Background" Value="{DynamicResource ChromeBg}" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="MinWidth" Value="240" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Grid SnapsToDevicePixels="True">
              <Border x:Name="templateRoot"
                      Background="{TemplateBinding Background}"
                      Padding="{TemplateBinding Padding}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Grid.Column="0"
                                    ContentSource="Header"
                                    RecognizesAccessKey="True"
                                    VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1"
                             x:Name="SubmenuArrow"
                             Text="&#xE76C;"
                             FontFamily="Segoe MDL2 Assets"
                             FontSize="10"
                             Foreground="{DynamicResource Muted}"
                             VerticalAlignment="Center"
                             Visibility="Collapsed"
                             Margin="12,0,0,0" />
                </Grid>
              </Border>
              <Popup x:Name="PART_Popup"
                     AllowsTransparency="True"
                     IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                     Placement="Right"
                     HorizontalOffset="-4"
                     PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}">
                <Border Background="{DynamicResource ChromeBg}"
                        BorderBrush="{DynamicResource Stroke}"
                        BorderThickness="1"
                        Padding="2">
                  <ScrollViewer Style="{DynamicResource MenuScrollViewerStyle}">
                    <ItemsPresenter x:Name="ItemsPresenter"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource ButtonHover}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
              <Trigger Property="HasItems" Value="True">
                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource ButtonHover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BrowserSubMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource BrowserMenuItemStyle}">
      <Setter Property="Padding" Value="18,7,14,7" />
      <Setter Property="MinWidth" Value="200" />
    </Style>

    <Style x:Key="BrowserMenuSeparatorStyle" TargetType="Separator">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1"
                    Margin="8,5"
                    Background="{DynamicResource Stroke}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BrowserSubMenuStyle" TargetType="Menu" BasedOn="{StaticResource {x:Type Menu}}">
      <Setter Property="Background" Value="{DynamicResource ChromeBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Menu">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ItemsPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollViewer" x:Key="MenuScrollViewerStyle">
      <Setter Property="Background" Value="{DynamicResource ChromeBg}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollViewer">
            <Grid Background="{TemplateBinding Background}">
              <ScrollContentPresenter Margin="{TemplateBinding Padding}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="MenuItem" x:Key="SubMenuSeparatorStyle">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1"
                    Margin="8,5"
                    Background="{DynamicResource Stroke}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Popup" x:Key="SubMenuPopupStyle">
      <Setter Property="AllowsTransparency" Value="True" />
    </Style>

    <Style x:Key="DarkScrollBar" TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="Transparent">
              <Track x:Name="PART_Track"
                     Orientation="{TemplateBinding Orientation}">
                <Track.Thumb>
                  <Thumb BorderThickness="0"
                         Margin="0,2"
                         x:Name="Thumb">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="{DynamicResource ScrollThumb}"
                                CornerRadius="4"
                                Width="6"
                                HorizontalAlignment="Center" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ScrollThumbHover}" />
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ScrollThumbPressed}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="RootGrid" Background="{DynamicResource AppBg}" Opacity="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="42" />
      <RowDefinition Height="*" />
      <RowDefinition Height="22" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource TitleBg}"
            BorderBrush="{DynamicResource SubtleStroke}"
            BorderThickness="0,0,0,1"
            PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown"
            PreviewMouseMove="TitleBar_PreviewMouseMove"
            PreviewMouseLeftButtonUp="TitleBar_PreviewMouseLeftButtonUp">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="13,0,14,0">
          <TextBlock Text="T"
                     Foreground="{DynamicResource Cyan}"
                     FontSize="17"
                     FontWeight="Bold"
                     VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Column="1"
              Margin="0,5,8,3"
              shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <DockPanel HorizontalAlignment="Left">
            <Button DockPanel.Dock="Right"
                    Content="&#xE710;"
                    Click="NewTab_Click"
                    Style="{StaticResource IconButton}"
                    Width="28"
                    Height="30"
                    Margin="1,0,0,0"
                    FontSize="12"
                    ToolTip="New tab"
                    Visibility="Visible" />
            <ItemsControl x:Name="TabStrip"
                          VerticalAlignment="Center"
                          PreviewMouseLeftButtonDown="TabStrip_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="TabStrip_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="TabStrip_PreviewMouseLeftButtonUp"
                          LostMouseCapture="TabStrip_LostMouseCapture">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <local:AnimatedTabPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border MinWidth="48"
                            Height="30"
                            Margin="0,0,3,0"
                            Padding="9,0"
                            Background="{Binding TabBrush}"
                            BorderBrush="{Binding AccentBrush}"
                            BorderThickness="{Binding TabBorderThickness}"
                            CornerRadius="4"
                            MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                            Tag="{Binding}">
                      <Border.ContextMenu>
                        <ContextMenu Style="{StaticResource BrowserContextMenuStyle}">
                          <MenuItem Header="Split right"
                                    Click="SplitTab_Click"
                                    Tag="{Binding}" />
                          <MenuItem Header="Pop out tab"
                                    Click="PopOutTab_Click"
                                    Tag="{Binding}" />
                        </ContextMenu>
                      </Border.ContextMenu>
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="RenderTransform">
                            <Setter.Value>
                              <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Setter.Value>
                          </Setter>
                          <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                              <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                  <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                     From="0.97" To="1.0" Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                     From="0.97" To="1.0" Duration="0:0:0.2" />
                                  </Storyboard>
                                </BeginStoryboard>
                              </DataTrigger.EnterActions>
                              <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                  <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                     To="1.0" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                     To="1.0" Duration="0:0:0.15" />
                                  </Storyboard>
                                </BeginStoryboard>
                              </DataTrigger.ExitActions>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center">
                          <Ellipse Width="7"
                                   Height="7"
                                   Fill="{Binding AccentBrush}"
                                   VerticalAlignment="Center" />
                          <Button Content="{Binding MuteIcon}"
                                  Click="MuteButton_Click"
                                  Tag="{Binding}"
                                  Width="20"
                                  Height="20"
                                  FontSize="13"
                                  FontFamily="Segoe UI Emoji"
                                  Margin="3,0,0,0"
                                  Padding="0"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  Foreground="{Binding MuteForeground}"
                                  VerticalAlignment="Center"
                                  ToolTip="{Binding MuteToolTip}">
                            <Button.Style>
                              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding ShowMuteIcon}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Title}"
                                   Foreground="{DynamicResource Text}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="12" />
                        <Button Grid.Column="2"
                                Content="&#xE711;"
                                Click="CloseTab_Click"
                                Tag="{Binding}"
                                Style="{StaticResource IconButton}"
                                Width="22"
                                Height="20"
                                Margin="8,0,0,0"
                                FontSize="10"
                                ToolTip="Close tab" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Grid>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Content="&#xE921;"
                  Click="Minimize_Click"
                  Style="{StaticResource TitleBarButton}"
                  ToolTip="Minimize" />
          <Button x:Name="MaximizeRestoreBtn" Content="&#xE922;"
                  Click="MaximizeRestore_Click"
                  Style="{StaticResource TitleBarButton}"
                  ToolTip="Maximize" />
          <Button Content="&#xE8BB;"
                  Click="CloseWindow_Click"
                  Style="{StaticResource CloseTitleBarButton}"
                  ToolTip="Close" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Background="{DynamicResource ChromeBg}"
            BorderBrush="{DynamicResource SubtleStroke}"
            BorderThickness="0,0,0,1">
      <Grid Margin="6,5,6,7">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="29" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0">
          <Button x:Name="BackButton"
                  Content="&#xE72B;"
                  Click="Back_Click"
                  Style="{StaticResource IconButton}"
                  BorderBrush="{DynamicResource SubtleStroke}"
                  ToolTip="Back" />
          <Button x:Name="ForwardButton"
                  Content="&#xE72A;"
                  Click="Forward_Click"
                  Style="{StaticResource IconButton}"
                  Margin="4,0,0,0"
                  ToolTip="Forward" />
          <Button x:Name="ReloadButton"
                  Content="&#xE72C;"
                  Click="Reload_Click"
                  Style="{StaticResource IconButton}"
                  Margin="4,0,0,0"
                  ToolTip="Reload" />
          <Button Content="&#xE80F;"
                  Click="Home_Click"
                  Style="{StaticResource IconButton}"
                  Margin="4,0,0,0"
                  ToolTip="Start page" />
        </StackPanel>

        <Border Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,8,0"
                Background="{DynamicResource InputBg}"
                BorderBrush="{DynamicResource Stroke}"
                BorderThickness="1"
                CornerRadius="7"
                Height="27"
                VerticalAlignment="Center">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

               <TextBlock Grid.Column="0"
                           Text="&#xE721;"
                           FontFamily="Segoe MDL2 Assets"
                           Foreground="{DynamicResource Muted}"
                           Margin="12,0,8,0"
                           VerticalAlignment="Center"
                           FontSize="12" />
            <TextBox x:Name="AddressBox"
                     Grid.Column="1"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource Text}"
                     CaretBrush="{DynamicResource Lime}"
                     FontSize="12.5"
                     Padding="0,5,8,0"
                     PreviewKeyDown="AddressBox_PreviewKeyDown" />
            <Button Grid.Column="2"
                    Content="Go"
                    Click="Go_Click"
                    IsDefault="True"
                    Style="{StaticResource MicroButton}"
                  BorderBrush="{DynamicResource SubtleStroke}"
                    Margin="0,2,3,2"
                    Height="21"
                    ToolTip="Go to address" />
          </Grid>
        </Border>

        <StackPanel Grid.Row="0"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0">
<Button x:Name="BookmarkButton"
                   Content="&#xE734;"
                   Click="Bookmark_Click"
                   Style="{StaticResource IconButton}"
                   BorderBrush="{DynamicResource Pink}"
                    ToolTip="Add bookmark"
                    Visibility="Visible" />
          <Button x:Name="ReaderButton"
                  Content="&#xE8B9;"
                  Click="ReaderMode_Click"
                  Style="{StaticResource IconButton}"
                  Margin="4,0,0,0"
                  ToolTip="Toggle reader mode"
                  Visibility="Collapsed" />
          <Button Content="&#xE8A4;"
                  Click="ShowBookmarks_Click"
                  Style="{StaticResource IconButton}"
                  Margin="4,0,0,0"
                   ToolTip="Saved bookmarks"
                   Visibility="Visible" />
          <Button Content="&#xE81C;"
                  Click="ShowHistory_Click"
                  Style="{StaticResource IconButton}"
                  Margin="4,0,0,0"
                   ToolTip="History"
                   Visibility="Visible" />
          <Button Content="&#xE896;"
                  Click="ShowDownloads_Click"
                  Style="{StaticResource IconButton}"
                  Margin="4,0,0,0"
                   ToolTip="Downloads"
                   Visibility="Visible" />
          <Button Content="&#xE75C;"
                  Click="ClearData_Click"
                  Style="{StaticResource IconButton}"
                  Margin="4,0,0,0"
                   ToolTip="Clear browsing data"
                   Visibility="Visible" />
          <Button x:Name="PrivacyButton"
                  Content="&#xE83D;"
                  Click="Privacy_Click"
                  Style="{StaticResource IconButton}"
                  BorderBrush="{DynamicResource Lime}"
                  Margin="8,0,0,0"
                  ToolTip="Privacy permissions" />
          <Button x:Name="PrivateButton"
                  Content="PVT"
                  Click="Private_Click"
                  Style="{StaticResource MicroButton}"
                  BorderBrush="{DynamicResource Pink}"
                  Margin="4,0,0,0"
                  ToolTip="Open private window"
                  Visibility="Collapsed" />
          <Button x:Name="MemoryButton"
                   Content="RAM"
                   Click="SleepTabs_Click"
                   Style="{StaticResource MicroButton}"
                   BorderBrush="{DynamicResource SubtleStroke}"
                   Margin="4,0,0,0"
                   ToolTip="Click to hibernate all inactive tabs"
                   Visibility="Visible">
            <Button.RenderTransform>
              <ScaleTransform ScaleX="1" ScaleY="1" />
            </Button.RenderTransform>
            <Button.RenderTransformOrigin>
              <Point X="0.5" Y="0.5" />
            </Button.RenderTransformOrigin>
          </Button>
          <Button x:Name="AiToggle"
                  Content="AI"
                  Click="AiToggle_Click"
                  Style="{StaticResource MicroButton}"
                  BorderBrush="{DynamicResource SubtleStroke}"
                  Margin="4,0,0,0"
                  ToolTip="Toggle AI chat sidebar"
                  Visibility="Visible" />
          <Button x:Name="MenuButton"
                  Content="&#xE712;"
                  Click="Menu_Click"
                  Style="{StaticResource IconButton}"
                  Margin="4,0,0,0"
                  ToolTip="Menu">
            <Button.ContextMenu>
              <ContextMenu x:Name="BrowserMenu"
                           Style="{StaticResource BrowserContextMenuStyle}"
                           Placement="Bottom">
                <MenuItem Header="&#xE710;  New tab"
                          Style="{StaticResource BrowserMenuItemStyle}"
                          Click="NewTab_Click" />
                <Separator Style="{StaticResource BrowserMenuSeparatorStyle}" />
                <MenuItem Header="&#xE72B;  Back"
                          Style="{StaticResource BrowserMenuItemStyle}"
                          Click="Back_Click" />
                <MenuItem Header="&#xE72A;  Forward"
                          Style="{StaticResource BrowserMenuItemStyle}"
                          Click="Forward_Click" />
                <MenuItem Header="&#xE72C;  Reload"
                          Style="{StaticResource BrowserMenuItemStyle}"
                          Click="Reload_Click" />
                <MenuItem Header="&#xE8B9;  Reader mode"
                          Style="{StaticResource BrowserMenuItemStyle}"
                          IsCheckable="True"
                          x:Name="ReaderModeMenuItem"
                          Click="ReaderMode_Click"
                          Visibility="Collapsed" />
                <MenuItem Header="&#xE740;  Full screen"
                          Style="{StaticResource BrowserMenuItemStyle}"
                          Click="FullScreen_Click" />
                <Separator Style="{StaticResource BrowserMenuSeparatorStyle}" />
                <MenuItem Header="&#xE80F;  Home (start page)"
                          Style="{StaticResource BrowserMenuItemStyle}"
                          Click="Home_Click" />
                <MenuItem Header="&#xE734;  Bookmark this page"
                          Style="{StaticResource BrowserMenuItemStyle}"
                          Click="Bookmark_Click" />
                <MenuItem x:Name="ForceDarkMenuItem"
                          Header="&#xE7B8;  Force dark page"
                          Style="{StaticResource BrowserMenuItemStyle}"
                          IsCheckable="True"
                          Checked="ForceDarkMenu_Checked"
                          Unchecked="ForceDarkMenu_Unchecked" />
                <MenuItem Header="&#xE81E;  Find in page"
                          Style="{StaticResource BrowserMenuItemStyle}"
                          Click="FindInPage_Click" />
                <MenuItem Header="&#xE914;  Print"
                          Style="{StaticResource BrowserMenuItemStyle}"
                          Click="Print_Click" />
                <MenuItem Header="&#xE8A4;  Library"
                          Style="{StaticResource BrowserMenuItemStyle}">
                  <MenuItem Header="&#xE8A4;  Bookmarks"
                            Style="{StaticResource BrowserSubMenuItemStyle}"
                            Click="ShowBookmarks_Click" />
                  <MenuItem Header="&#xE81C;  History"
                            Style="{StaticResource BrowserSubMenuItemStyle}"
                            Click="ShowHistory_Click" />
                  <MenuItem Header="&#xE896;  Downloads"
                            Style="{StaticResource BrowserSubMenuItemStyle}"
                            Click="ShowDownloads_Click" />
                  <MenuItem Header="&#xE7B9;  Extensions"
                            Style="{StaticResource BrowserSubMenuItemStyle}"
                            Click="ShowExtensions_Click" />
                </MenuItem>
                <MenuItem Header="&#xE790;  Zoom"
                          Style="{StaticResource BrowserMenuItemStyle}">
                  <MenuItem Header="&#xE7A1;  Zoom in"
                            Style="{StaticResource BrowserSubMenuItemStyle}"
                            Click="ZoomIn_Click" />
                  <MenuItem Header="&#xE7A0;  Zoom out"
                            Style="{StaticResource BrowserSubMenuItemStyle}"
                            Click="ZoomOut_Click" />
                  <MenuItem Header="&#xE777;  Reset zoom"
                            Style="{StaticResource BrowserSubMenuItemStyle}"
                            Click="ResetZoom_Click" />
                </MenuItem>
                <MenuItem Header="&#xE77B;  Privacy &amp; data"
                          Style="{StaticResource BrowserMenuItemStyle}">
                  <MenuItem Header="&#xE83D;  Privacy settings"
                            Style="{StaticResource BrowserSubMenuItemStyle}"
                            Click="Privacy_Click" />
                  <MenuItem Header="&#xE708;  Open private window"
                            Style="{StaticResource BrowserSubMenuItemStyle}"
                            Click="Private_Click" />
                  <MenuItem Header="&#xE75C;  Clear browsing data"
                            Style="{StaticResource BrowserSubMenuItemStyle}"
                            Click="ClearData_Click" />
                  <MenuItem Header="&#xE825;  Cookies &amp; site data"
                            Style="{StaticResource BrowserSubMenuItemStyle}"
                            Click="SiteData_Click" />
                  <Separator Style="{StaticResource BrowserMenuSeparatorStyle}" />
                  <MenuItem x:Name="UblockMenuItem"
                            Header="&#xE7B9;  uBlock Origin"
                            Style="{StaticResource BrowserSubMenuItemStyle}"
                            IsCheckable="True"
                            Click="UblockToggle_Click" />
                </MenuItem>
                <MenuItem Header="&#xE8B2;  Tools"
                          Style="{StaticResource BrowserMenuItemStyle}">
                  <MenuItem Header="&#xE90D;  Hibernate inactive tabs"
                            Style="{StaticResource BrowserSubMenuItemStyle}"
                            Click="SleepTabs_Click" />
                  <MenuItem Header="&#xE710;  AI Chat"
                            Style="{StaticResource BrowserSubMenuItemStyle}"
                            Click="AiToggle_Click" />
                </MenuItem>
                <Separator Style="{StaticResource BrowserMenuSeparatorStyle}" />
                <MenuItem Header="&#xE713;  Settings"
                          Style="{StaticResource BrowserMenuItemStyle}"
                          Click="ShowSettings_Click" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>

        <ScrollViewer x:Name="BookmarkBar"
                      Grid.Row="1"
                      Grid.ColumnSpan="3"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      Height="26"
                      Margin="0,4,0,0"
                      Visibility="Collapsed">
          <StackPanel x:Name="BookmarkBarItems"
                      Orientation="Horizontal"
                      VerticalAlignment="Center" />
        </ScrollViewer>
      </Grid>
    </Border>

    <Grid Grid.Row="2"
          x:Name="BrowserHost"
          Background="{DynamicResource AppBg}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="AiSidebarColumn" Width="0" />
      </Grid.ColumnDefinitions>

      <Grid x:Name="BrowserPaneHost"
            Grid.Column="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="PrimaryPaneColumn" Width="*" />
          <ColumnDefinition x:Name="SplitPaneDividerColumn" Width="0" />
          <ColumnDefinition x:Name="SplitPaneColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="WebViewHost"
              Grid.Column="0"
              Background="{DynamicResource AppBg}" />

        <Grid x:Name="InternalPageHost"
              Grid.Column="0"
              Background="{DynamicResource AppBg}"
              Visibility="Collapsed" />

        <Grid x:Name="LoadingOverlay"
              Grid.Column="0"
              Visibility="Collapsed"
              Background="{DynamicResource AppBg}"
              IsHitTestVisible="False">
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0,0,0,36">
            <Border Width="36"
                    Height="36"
                    CornerRadius="18"
                    BorderBrush="{DynamicResource Cyan}"
                    BorderThickness="3"
                    Background="Transparent"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12"
                    RenderTransformOrigin="0.5,0.5">
              <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                       From="0" To="360" Duration="0:0:0.8" />
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Border.Triggers>
              <Border.RenderTransform>
                <RotateTransform />
              </Border.RenderTransform>
            </Border>
            <Ellipse Width="18"
                     Height="18"
                     Fill="{DynamicResource Cyan}"
                     Opacity="0.3"
                     HorizontalAlignment="Center"
                     Margin="0,-50,0,0" />
            <TextBlock x:Name="LoadingTitleText"
                       Text="Loading"
                       Foreground="{DynamicResource Text}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8" />
            <TextBlock Text="Preparing page"
                       Foreground="{DynamicResource Muted}"
                       FontSize="12"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>

        <Grid x:Name="StartOverlay"
              Grid.Column="0"
              Visibility="Visible">

          <Canvas x:Name="StartBgCanvas"
                  Background="{DynamicResource AppBg}"
                  IsHitTestVisible="False"
                  Focusable="False" />

            <StackPanel Width="620"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,0,42"
                        Opacity="0"
                        RenderTransformOrigin="0.5,0.5">
              <StackPanel.RenderTransform>
                <TranslateTransform Y="20" />
              </StackPanel.RenderTransform>
              <StackPanel.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                       From="0" To="1" Duration="0:0:0.6"
                                       EasingFunction="{StaticResource CubicEaseOut}" />
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y"
                                       From="20" To="0" Duration="0:0:0.6"
                                       EasingFunction="{StaticResource CubicEaseOut}" />
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </StackPanel.Triggers>
              <TextBlock Text="Tabloid"
                         Foreground="{DynamicResource Text}"
                         FontSize="44"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,4">
                <TextBlock.Effect>
                  <DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.3" Color="#724DDF" />
                </TextBlock.Effect>
              </TextBlock>
              <TextBlock Text="Private local search"
                         Foreground="{DynamicResource Muted}"
                         FontSize="13"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,18" />

              <Grid Height="40">
                <Border Background="#15FFFFFF"
                        CornerRadius="8"
                        Margin="0" />
                <Border x:Name="SearchBorder"
                        Background="{DynamicResource ChromeBg}"
                        BorderBrush="{DynamicResource Stroke}"
                        BorderThickness="1"
                        CornerRadius="8"
                        PreviewMouseDown="StartSearchSurface_PreviewMouseDown">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Text="&#xE721;"
                             FontFamily="Segoe MDL2 Assets"
                             Foreground="{DynamicResource Muted}"
                             Margin="14,0,9,0"
                             VerticalAlignment="Center" />
                  <TextBox x:Name="StartSearchBox"
                           Grid.Column="1"
                           Background="Transparent"
                           BorderThickness="0"
                           Foreground="{DynamicResource Text}"
                           CaretBrush="{DynamicResource Cyan}"
                           FontSize="14"
                           Padding="0,9,10,0"
                           PreviewKeyDown="StartSearchBox_PreviewKeyDown" />
                  <Button Grid.Column="2"
                          Content="&#xE721;"
                          Click="StartSearchGo_Click"
                          Style="{StaticResource IconButton}"
                          Background="Transparent"
                          BorderThickness="0"
                          Width="34"
                          Height="30"
                          Margin="0,5,5,5"
                          ToolTip="Search or open address" />
                </Grid>
              </Border>
            </Grid>

            <UniformGrid Columns="4"
                         x:Name="QuickLinksPanel"
                         Margin="0,14,0,0">
              <Button Content="DuckDuckGo"
                      Click="QuickDuckDuckGo_Click"
                      Style="{StaticResource MicroButton}"
                      Height="32"
                      Margin="0,0,8,0" />
              <Button Content="Startpage"
                      Click="QuickStartpage_Click"
                      Style="{StaticResource MicroButton}"
                      Height="32"
                      Margin="0,0,8,0" />
              <Button Content="GitHub"
                      Click="QuickGitHub_Click"
                      Style="{StaticResource MicroButton}"
                      Height="32"
                      Margin="0,0,8,0" />
              <Button Content="HN"
                      Click="QuickHackerNews_Click"
                      Style="{StaticResource MicroButton}"
                      Height="32"
                      Margin="0,0,8,0" />
            </UniformGrid>
          </StackPanel>
        </Grid>

        <GridSplitter x:Name="SplitPaneSplitter"
                      Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource SubtleStroke}"
                      Cursor="SizeWE"
                      Visibility="Collapsed"
                      IsTabStop="False" />

        <Grid x:Name="SplitPane"
              Grid.Column="2"
              Background="{DynamicResource AppBg}"
              Visibility="Collapsed">
          <Grid x:Name="SplitWebViewHost"
                Background="{DynamicResource AppBg}" />

          <Grid x:Name="SplitLoadingOverlay"
                Visibility="Collapsed"
                Background="{DynamicResource AppBg}"
                IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,0,36">
              <Border Width="30"
                      Height="30"
                      CornerRadius="15"
                      BorderBrush="{DynamicResource Cyan}"
                      BorderThickness="3"
                      Background="Transparent"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,10"
                      RenderTransformOrigin="0.5,0.5">
                <Border.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                         From="0" To="360" Duration="0:0:0.8" />
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Border.Triggers>
                <Border.RenderTransform>
                  <RotateTransform />
                </Border.RenderTransform>
              </Border>
              <TextBlock Text="Loading"
                         Foreground="{DynamicResource Text}"
                         FontSize="18"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>

          <Border HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,10,10,0"
                  Background="{DynamicResource ChromeBg}"
                  BorderBrush="{DynamicResource Stroke}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="2">
            <StackPanel Orientation="Horizontal">
              <Button Content="&#xE8A7;"
                      Click="FocusSplitTab_Click"
                      Style="{StaticResource IconButton}"
                      Width="26"
                      Height="24"
                      FontSize="11"
                      ToolTip="Focus split tab" />
              <Button Content="&#xE894;"
                      Click="CloseSplit_Click"
                      Style="{StaticResource IconButton}"
                      Width="26"
                      Height="24"
                      FontSize="10"
                      Margin="2,0,0,0"
                      ToolTip="Close split view" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <GridSplitter x:Name="AiSplitter"
                    Grid.Column="1"
                    Width="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    IsTabStop="False"
                    ToolTip="Drag to resize sidebar"
                    Cursor="SizeWE"
                    Visibility="Collapsed"
                    DragCompleted="AiSplitter_DragCompleted">
        <GridSplitter.Style>
          <Style TargetType="GridSplitter">
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cyan}" />
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </GridSplitter.Style>
      </GridSplitter>
      <Border x:Name="AiSidebar"
              Grid.Column="2"
              Visibility="Collapsed"
              Background="{DynamicResource ChromeBg}"
              BorderBrush="{DynamicResource Stroke}"
              BorderThickness="1,0,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0"
                  BorderBrush="{DynamicResource SubtleStroke}"
                  BorderThickness="0,0,0,1">
          <Grid Margin="10,0,6,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="AI Chat"
                       Foreground="{DynamicResource Text}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="AiClearChatBtn"
                      Content="&#xE74D;"
                      Click="AiClearChat_Click"
                      Style="{StaticResource IconButton}"
                      Width="28"
                      Height="26"
                      FontSize="10"
                      ToolTip="Clear chat history" />
              <Button x:Name="AiSidebarClose"
                      Content="&#xE894;"
                      Click="AiSidebarClose_Click"
                      Style="{StaticResource IconButton}"
                      Width="28"
                      Height="26"
                      FontSize="10"
                      ToolTip="Close AI sidebar" />
            </StackPanel>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      x:Name="AiMessagesScroll"
                      VerticalScrollBarVisibility="Auto">
          <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}" />
          </ScrollViewer.Resources>
          <StackPanel x:Name="AiMessagesStack"
                      Margin="10,8,10,8" />
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource SubtleStroke}"
                BorderThickness="0,1,0,0"
                Padding="8,6,8,8">
          <StackPanel>
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,4">
              <ToggleButton x:Name="AiPageContextToggle"
                            Content="&#xE774;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11"
                            Width="26"
                            Height="20"
                            IsChecked="True"
                            ToolTip="Include page content for context"
                            BorderThickness="1"
                            Background="{DynamicResource ButtonBg}"
                            BorderBrush="{DynamicResource SubtleStroke}"
                            Padding="0"
                            Foreground="{DynamicResource Muted}" />
              <TextBlock Text="Include page"
                         Foreground="{DynamicResource Muted}"
                         FontSize="10"
                         VerticalAlignment="Center"
                         Margin="4,0,0,0" />
            </StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0"
                      Background="{DynamicResource InputBg}"
                      BorderBrush="{DynamicResource Stroke}"
                      BorderThickness="1"
                      CornerRadius="6"
                      VerticalAlignment="Center">
                <TextBox x:Name="AiInputBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource Text}"
                         CaretBrush="{DynamicResource Cyan}"
                         FontSize="13"
                         Padding="8,6,8,6"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxHeight="80"
                         VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="AiInput_PreviewKeyDown" />
              </Border>
              <Button x:Name="AiSendBtn"
                      Grid.Column="1"
                      Content="&#xE725;"
                      Click="AiSend_Click"
                      Style="{StaticResource IconButton}"
                      Width="30"
                      Height="30"
                      Margin="6,0,0,0"
                      FontSize="14"
                      ToolTip="Send message" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    </Grid>

    <Border Grid.Row="3"
            Background="{DynamicResource TitleBg}"
            BorderBrush="{DynamicResource SubtleStroke}"
            BorderThickness="0,1,0,0"
            Padding="7,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="StatusText"
                   Text="Ready"
                   Foreground="{DynamicResource Muted}"
                   VerticalAlignment="Center"
                   FontSize="11" />
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal">
          <TextBlock x:Name="LocalDataText"
                     Text="Local"
                     Foreground="{DynamicResource Lime}"
                     VerticalAlignment="Center"
                     FontSize="11"
                     Margin="0,0,12,0" />
          <TextBlock x:Name="ZoomText"
                     VerticalAlignment="Center"
                     FontSize="11"
                     Foreground="{DynamicResource Muted}"
                     Margin="0,0,12,0"
                     Visibility="Collapsed" />
          <TextBlock x:Name="MemoryStatusText"
                     Text="0 hibernated"
                     Foreground="{DynamicResource Muted}"
                     VerticalAlignment="Center"
                     FontSize="11" />
        </StackPanel>
      </Grid>
    </Border>

    <Popup x:Name="FindPopup"
           AllowsTransparency="True"
           Focusable="False"
           IsOpen="False">
      <Border x:Name="FindPopupContent"
              Background="{DynamicResource ChromeBg}"
              BorderBrush="{DynamicResource Stroke}"
              BorderThickness="1"
              CornerRadius="0,0,8,8"
              Padding="0"
              Width="260">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0"
                  x:Name="FindDragGrip"
                  Background="Transparent"
                  Cursor="Hand"
                  PreviewMouseLeftButtonDown="FindDragGrip_MouseLeftButtonDown"
                  PreviewMouseMove="FindDragGrip_MouseMove"
                  PreviewMouseLeftButtonUp="FindDragGrip_MouseLeftButtonUp">
            <TextBlock Text="&#xE81E;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="12"
                       Foreground="{DynamicResource Muted}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
          </Border>
          <TextBox x:Name="FindTextBox"
                   Grid.Column="1"
                   Background="{DynamicResource InputBg}"
                   BorderBrush="{DynamicResource Stroke}"
                   BorderThickness="1"
                   Foreground="{DynamicResource Text}"
                   CaretBrush="{DynamicResource Cyan}"
                   FontSize="12"
                   Padding="6,2"
                   VerticalAlignment="Center"
                   TextChanged="FindTextBox_TextChanged"
                   PreviewKeyDown="FindTextBox_PreviewKeyDown" />
          <TextBlock x:Name="FindMatchCount"
                     Grid.Column="2"
                     Foreground="{DynamicResource Muted}"
                     FontSize="11"
                     VerticalAlignment="Center"
                     Margin="8,0,0,0"
                     MinWidth="40"
                     TextAlignment="Right" />
          <Button Grid.Column="3"
                  Content="▲"
                  FontFamily="Segoe UI"
                  Style="{StaticResource IconButton}"
                  Width="26"
                  Height="24"
                  FontSize="13"
                  Margin="4,0,0,0"
                  Click="FindPrev_Click"
                  ToolTip="Previous match" />
          <Button Grid.Column="4"
                  Content="▼"
                  FontFamily="Segoe UI"
                  Style="{StaticResource IconButton}"
                  Width="26"
                  Height="24"
                  FontSize="13"
                  Margin="2,0,0,0"
                  Click="FindNext_Click"
                  ToolTip="Next match" />
          <Button Grid.Column="5"
                  Content="&#xE894;"
                  Style="{StaticResource IconButton}"
                  Width="26"
                  Height="24"
                  FontSize="10"
                  Margin="6,0,0,0"
                  Click="FindClose_Click"
                  ToolTip="Close" />
        </Grid>
      </Border>
    </Popup>

    <Canvas x:Name="TabDragOverlay" Grid.RowSpan="4" IsHitTestVisible="False" />
  </Grid>
</Window>

