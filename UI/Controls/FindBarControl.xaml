<UserControl x:Class="TabloidBrowser.FindBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Popup x:Name="FindPopup"
         AllowsTransparency="True"
         Focusable="False"
         IsOpen="False">
    <Border x:Name="FindPopupContent"
            Background="{DynamicResource ChromeBg}"
            BorderBrush="{DynamicResource Stroke}"
            BorderThickness="1"
            CornerRadius="0,0,8,8"
            Padding="0"
            Width="260">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                x:Name="FindDragGrip"
                Background="Transparent"
                Cursor="Hand">
          <TextBlock Text="&#xE81E;"
                     FontFamily="Segoe MDL2 Assets"
                     FontSize="12"
                     Foreground="{DynamicResource Muted}"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center" />
        </Border>
        <TextBox x:Name="FindTextBox"
                 Grid.Column="1"
                 Background="{DynamicResource InputBg}"
                 BorderBrush="{DynamicResource Stroke}"
                 BorderThickness="1"
                 Foreground="{DynamicResource Text}"
                 CaretBrush="{DynamicResource Accent}"
                 FontSize="12"
                 Padding="6,2"
                 VerticalAlignment="Center" />
        <TextBlock x:Name="FindMatchCount"
                   Grid.Column="2"
                   Foreground="{DynamicResource Muted}"
                   FontSize="11"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"
                   MinWidth="40"
                   TextAlignment="Right" />
        <Button Grid.Column="3"
                x:Name="FindPrevBtn"
                Content="▲"
                FontFamily="Segoe UI"
                Style="{StaticResource IconButton}"
                Width="26"
                Height="24"
                FontSize="13"
                Margin="4,0,0,0"
                ToolTip="Previous match" />
        <Button Grid.Column="4"
                x:Name="FindNextBtn"
                Content="▼"
                FontFamily="Segoe UI"
                Style="{StaticResource IconButton}"
                Width="26"
                Height="24"
                FontSize="13"
                Margin="2,0,0,0"
                ToolTip="Next match" />
        <Button Grid.Column="5"
                x:Name="FindCloseBtn"
                Content="&#xE894;"
                Style="{StaticResource IconButton}"
                Width="26"
                Height="24"
                FontSize="10"
                Margin="6,0,0,0"
                ToolTip="Close" />
      </Grid>
    </Border>
  </Popup>
</UserControl>
