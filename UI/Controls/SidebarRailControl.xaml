<UserControl x:Class="TabloidBrowser.SidebarRailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RenderTransformOrigin="0.5,0.5"
             Opacity="0"
             Width="56"
             Height="340">
  <UserControl.RenderTransform>
    <TranslateTransform x:Name="RailTranslate" X="-10" />
  </UserControl.RenderTransform>
  <Border Background="{DynamicResource GlassSurface}"
          BorderBrush="{DynamicResource GlassEdge}"
          BorderThickness="1"
          CornerRadius="8"
          Padding="4">
    <Border.Effect>
      <DropShadowEffect BlurRadius="12"
                        ShadowDepth="2"
                        Opacity="0.24"
                        Color="#000000" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border x:Name="RailDragGrip"
              Grid.Row="0"
              Height="18"
              Background="Transparent"
              Cursor="SizeAll"
              ToolTip="Drag sidebar"
              MouseLeftButtonDown="RailDragGrip_MouseLeftButtonDown"
              MouseMove="RailDragGrip_MouseMove"
              MouseLeftButtonUp="RailDragGrip_MouseLeftButtonUp"
              LostMouseCapture="RailDragGrip_LostMouseCapture">
        <Border Width="18"
                Height="3"
                CornerRadius="2"
                Background="{DynamicResource StrokeStrong}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center" />
      </Border>

      <StackPanel Grid.Row="1">
        <RadioButton x:Name="HomeNavigationButton"
                     GroupName="SidebarRail"
                     Content="&#xE80F;"
                     ToolTip="Home"
                     IsChecked="True"
                     Click="Home_Click"
                     Style="{StaticResource SidebarRailButton}" />
        <RadioButton x:Name="BookmarksNavigationButton"
                     GroupName="SidebarRail"
                     Content="&#xE734;"
                     ToolTip="Bookmarks"
                     Click="Bookmarks_Click"
                     Style="{StaticResource SidebarRailButton}" />
        <RadioButton x:Name="HistoryNavigationButton"
                     GroupName="SidebarRail"
                     Content="&#xE81C;"
                     ToolTip="History (Ctrl+H)"
                     Click="History_Click"
                     Style="{StaticResource SidebarRailButton}" />
        <RadioButton x:Name="DownloadsNavigationButton"
                     GroupName="SidebarRail"
                     Content="&#xE896;"
                     ToolTip="Downloads"
                     Click="Downloads_Click"
                     Style="{StaticResource SidebarRailButton}" />
        <RadioButton x:Name="ExtensionsNavigationButton"
                     GroupName="SidebarRail"
                     Content="&#xE8A9;"
                     ToolTip="Extensions"
                     Click="Extensions_Click"
                     Style="{StaticResource SidebarRailButton}" />
      </StackPanel>

      <Border Grid.Row="2"
              Height="1"
              Background="#36FFFFFF"
              VerticalAlignment="Center"
              Margin="1,0" />

      <RadioButton x:Name="SettingsNavigationButton"
                   Grid.Row="3"
                   GroupName="SidebarRail"
                   Content="&#xE713;"
                   ToolTip="Settings"
                   Click="Settings_Click"
                   Style="{StaticResource SidebarRailButton}" />

    </Grid>
  </Border>
</UserControl>
