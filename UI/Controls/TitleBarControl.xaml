<UserControl x:Class="TabloidBrowser.TitleBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:local="clr-namespace:TabloidBrowser">
  <Border Background="{DynamicResource TitleBg}"
          BorderBrush="{DynamicResource SubtleStroke}"
          BorderThickness="0,0,0,1"
          PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown"
          PreviewMouseMove="TitleBar_PreviewMouseMove"
          PreviewMouseLeftButtonUp="TitleBar_PreviewMouseLeftButtonUp">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Margin="13,0,14,0">
        <Path Data="M 152,110 H 238 V 194 H 324 V 264 H 238 V 345 C 238,410 275,435 322,435 H 324 V 500 H 314 C 212,500 152,445 152,335 Z"
              Fill="#FFFFFF"
              Stretch="Uniform"
              Height="18"
              VerticalAlignment="Center" />
      </StackPanel>

      <Grid Grid.Column="1"
            Margin="0,5,8,3"
            shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel HorizontalAlignment="Left">
          <Button DockPanel.Dock="Right"
                  Content="&#xE710;"
                  Click="NewTab_Click"
                  Style="{StaticResource IconButton}"
                  Width="28"
                  Height="30"
                  Margin="1,0,0,0"
                  FontSize="12"
                  ToolTip="New tab"
                  Visibility="Visible" />
          <ItemsControl x:Name="TabStrip"
                        VerticalAlignment="Center"
                        PreviewMouseLeftButtonDown="TabStrip_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="TabStrip_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="TabStrip_PreviewMouseLeftButtonUp"
                        LostMouseCapture="TabStrip_LostMouseCapture">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <local:AnimatedTabPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border MinWidth="48"
                        Height="30"
                        Margin="0,0,3,0"
                        Padding="9,0"
                        Background="{Binding TabBrush}"
                        BorderBrush="{Binding AccentBrush}"
                        BorderThickness="{Binding TabBorderThickness}"
                        CornerRadius="4"
                        MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                        Tag="{Binding}">
                  <Border.ContextMenu>
                    <ContextMenu Style="{StaticResource BrowserContextMenuStyle}">
                      <MenuItem Header="Split right"
                                Click="SplitTab_Click"
                                Tag="{Binding}" />
                      <MenuItem Header="Pop out tab"
                                Click="PopOutTab_Click"
                                Tag="{Binding}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="RenderTransform">
                        <Setter.Value>
                          <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Setter.Value>
                      </Setter>
                      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                          <DataTrigger.EnterActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                 From="0.97" To="1.0" Duration="0:0:0.2" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                 From="0.97" To="1.0" Duration="0:0:0.2" />
                              </Storyboard>
                            </BeginStoryboard>
                          </DataTrigger.EnterActions>
                          <DataTrigger.ExitActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                 To="1.0" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                 To="1.0" Duration="0:0:0.15" />
                              </Storyboard>
                            </BeginStoryboard>
                          </DataTrigger.ExitActions>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center">
                      <Ellipse Width="7"
                               Height="7"
                               Fill="{Binding AccentBrush}"
                               VerticalAlignment="Center" />
                      <Button Content="{Binding MuteIcon}"
                              Click="MuteButton_Click"
                              Tag="{Binding}"
                              Width="20"
                              Height="20"
                              FontSize="13"
                              FontFamily="Segoe UI Emoji"
                              Margin="3,0,0,0"
                              Padding="0"
                              BorderThickness="0"
                              Background="Transparent"
                              Foreground="{Binding MuteForeground}"
                              VerticalAlignment="Center"
                              ToolTip="{Binding MuteToolTip}">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ShowMuteIcon}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               Foreground="{DynamicResource Text}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontSize="12" />
                    <Button Grid.Column="2"
                            Content="&#xE711;"
                            Click="CloseTab_Click"
                            Tag="{Binding}"
                            Style="{StaticResource IconButton}"
                            Width="22"
                            Height="20"
                            Margin="8,0,0,0"
                            FontSize="10"
                            ToolTip="Close tab" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Grid>

      <StackPanel Grid.Column="2"
                  Orientation="Horizontal"
                  Margin="0,7,8,0"
                  VerticalAlignment="Top"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Content="&#xE921;"
                Click="Minimize_Click"
                Style="{StaticResource TitleBarButton}"
                ToolTip="Minimize" />
        <Button x:Name="MaximizeRestoreBtn"
                Content="&#xE922;"
                Click="MaximizeRestore_Click"
                Style="{StaticResource TitleBarButton}"
                ToolTip="Maximize" />
        <Button Content="&#xE8BB;"
                Click="CloseWindow_Click"
                Style="{StaticResource TitleBarButton}"
                ToolTip="Close" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
