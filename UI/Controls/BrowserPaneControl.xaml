<UserControl x:Class="TabloidBrowser.BrowserPaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="BrowserPaneHost">
    <Grid x:Name="WebViewHost"
          Background="{DynamicResource AppBg}" />

    <Grid x:Name="InternalPageHost"
          Background="{DynamicResource AppBg}"
          Visibility="Collapsed" />

    <!-- Cross-fade scrim: masks the hard WebView swap (HwndHost can't fade). -->
    <Border x:Name="SwapScrim"
            Background="{DynamicResource AppBg}"
            Opacity="0"
            IsHitTestVisible="False" />

    <Grid x:Name="LoadingOverlay"
          Visibility="Collapsed"
          Background="{DynamicResource AppBg}"
          IsHitTestVisible="False">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="0,0,0,36">
        <Border Width="36"
                Height="36"
                CornerRadius="18"
                BorderBrush="{DynamicResource Accent}"
                BorderThickness="3"
                Background="Transparent"
                HorizontalAlignment="Center"
                Margin="0,0,0,12"
                RenderTransformOrigin="0.5,0.5">
          <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                   From="0" To="360" Duration="0:0:0.8" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Border.Triggers>
          <Border.RenderTransform>
            <RotateTransform />
          </Border.RenderTransform>
        </Border>
        <Ellipse Width="18"
                 Height="18"
                 Fill="{DynamicResource Accent}"
                 Opacity="0.3"
                 HorizontalAlignment="Center"
                 Margin="0,-50,0,0" />
        <TextBlock x:Name="LoadingTitleText"
                   Text="Loading"
                   Foreground="{DynamicResource Text}"
                   FontSize="22"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8" />
        <TextBlock Text="Preparing page"
                   Foreground="{DynamicResource Muted}"
                   FontSize="12"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>

    <Grid x:Name="StartOverlay"
          Visibility="Visible">
      <Canvas x:Name="StartBgCanvas"
              Background="{DynamicResource AppBg}"
              IsHitTestVisible="False"
              Focusable="False" />
      <StackPanel x:Name="StartHero"
                  MaxWidth="760"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="32,24,32,40"
                  Opacity="0"
                  RenderTransformOrigin="0.5,0.5">
        <StackPanel.RenderTransform>
          <TranslateTransform Y="20" />
        </StackPanel.RenderTransform>
        <StackPanel.Triggers>
          <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.6"
                                 EasingFunction="{StaticResource CubicEaseOut}" />
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y"
                                 From="20" To="0" Duration="0:0:0.6"
                                 EasingFunction="{StaticResource CubicEaseOut}" />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </StackPanel.Triggers>
        <Border HorizontalAlignment="Center"
                Background="{DynamicResource ChromeBg}"
                BorderBrush="{DynamicResource SubtleStroke}"
                BorderThickness="1"
                CornerRadius="22"
                Padding="13,7"
                Margin="0,0,0,24">
          <StackPanel Orientation="Horizontal">
            <Border Width="22"
                    Height="22"
                    CornerRadius="11"
                    Background="{DynamicResource Accent}"
                    VerticalAlignment="Center">
              <TextBlock Text="T"
                         Foreground="White"
                         FontSize="13"
                         FontWeight="Bold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="TABLOID  ·  YOUR BROWSER, YOUR SPACE"
                       Foreground="{DynamicResource Text}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="10,0,2,0" />
          </StackPanel>
        </Border>
        <TextBlock Text="Where will curiosity take you?"
                   FontFamily="./Assets/Fonts/#Font208, Segoe UI"
                   Foreground="{DynamicResource Text}"
                   FontSize="36"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10">
          <TextBlock.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="18" Opacity="0.2" Color="#724DDF" />
          </TextBlock.Effect>
        </TextBlock>
        <TextBlock Text="Search the web or jump straight to a site."
                   Foreground="{DynamicResource Muted}"
                   FontSize="14"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,30" />
        <Border x:Name="SearchBorder"
                Background="{DynamicResource ChromeBg}"
                BorderBrush="{DynamicResource Stroke}"
                BorderThickness="1"
                CornerRadius="15"
                Padding="10"
                PreviewMouseDown="StartSearchSurface_PreviewMouseDown">
          <Grid MinHeight="50">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="36"
                    Height="36"
                    CornerRadius="11"
                    Background="{DynamicResource SurfaceRaised}"
                    VerticalAlignment="Center"
                    Margin="2,0,12,0">
              <TextBlock Text="&#xE721;"
                         FontFamily="Segoe MDL2 Assets"
                         Foreground="{DynamicResource Accent}"
                         FontSize="15"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <Grid Grid.Column="1" VerticalAlignment="Center">
              <TextBox x:Name="StartSearchBox"
                       Background="Transparent"
                       BorderThickness="0"
                       Foreground="{DynamicResource Text}"
                       CaretBrush="{DynamicResource Accent}"
                       FontSize="15"
                       Padding="0,10,10,10"
                       GotKeyboardFocus="StartSearchBox_GotKeyboardFocus"
                       LostKeyboardFocus="StartSearchBox_LostKeyboardFocus"
                       PreviewKeyDown="StartSearchBox_PreviewKeyDown" />
              <TextBlock Text="Search or enter an address..."
                         Foreground="{DynamicResource Muted}"
                         FontSize="14"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         Margin="0,0,8,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Text, ElementName=StartSearchBox}" Value="">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource Stroke}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0">
              <TextBlock Text="ENTER"
                         Foreground="{DynamicResource Muted}"
                         FontSize="10"
                         FontWeight="SemiBold" />
            </Border>
            <Button Grid.Column="3"
                    Content="&#xE721;"
                    Click="StartSearchGo_Click"
                    Style="{StaticResource IconButton}"
                    Background="{DynamicResource Accent}"
                    Foreground="White"
                    BorderThickness="0"
                    Width="38"
                    Height="38"
                    ToolTip="Search or open address" />
          </Grid>
        </Border>
        <StackPanel x:Name="QuickLinksPanel" Margin="0,34,0,0">
          <Grid Margin="2,0,0,13">
            <StackPanel>
              <TextBlock Text="QUICK LINKS"
                         Foreground="{DynamicResource Text}"
                         FontSize="11"
                         FontWeight="SemiBold" />
              <TextBlock Text="Your regular stops, one click away"
                         Foreground="{DynamicResource Muted}"
                         FontSize="11"
                         Margin="0,3,0,0" />
            </StackPanel>
            <TextBlock Text="4 SITES"
                       Foreground="{DynamicResource Muted}"
                       FontSize="9"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,2,0" />
          </Grid>
          <WrapPanel>
            <Button Click="QuickDuckDuckGo_Click"
                    Style="{StaticResource MicroButton}"
                    Background="{DynamicResource SurfaceBg}"
                    BorderBrush="{DynamicResource Stroke}"
                    Padding="13,11"
                    Width="170"
                    Height="76"
                    Margin="0,0,9,9">
              <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="11" Background="#263D62">
                  <TextBlock Text="D" Foreground="#A9C6FF" FontSize="17" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                  <TextBlock Text="DuckDuckGo" Foreground="{DynamicResource Text}" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="Private search" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,3,0,0" />
                </StackPanel>
              </StackPanel>
            </Button>
            <Button Click="QuickStartpage_Click"
                    Style="{StaticResource MicroButton}"
                    Background="{DynamicResource SurfaceBg}"
                    BorderBrush="{DynamicResource Stroke}"
                    Padding="13,11"
                    Width="170"
                    Height="76"
                    Margin="0,0,9,9">
              <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="11" Background="#283D35">
                  <TextBlock Text="S" Foreground="#8FE0B2" FontSize="17" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                  <TextBlock Text="Startpage" Foreground="{DynamicResource Text}" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="Private search" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,3,0,0" />
                </StackPanel>
              </StackPanel>
            </Button>
            <Button Click="QuickGitHub_Click"
                    Style="{StaticResource MicroButton}"
                    Background="{DynamicResource SurfaceBg}"
                    BorderBrush="{DynamicResource Stroke}"
                    Padding="13,11"
                    Width="170"
                    Height="76"
                    Margin="0,0,9,9">
              <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="11" Background="#34323F">
                  <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" Foreground="#D2C7F8" FontSize="15"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                  <TextBlock Text="GitHub" Foreground="{DynamicResource Text}" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="Explore projects" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,3,0,0" />
                </StackPanel>
              </StackPanel>
            </Button>
            <Button Click="QuickHackerNews_Click"
                    Style="{StaticResource MicroButton}"
                    Background="{DynamicResource SurfaceBg}"
                    BorderBrush="{DynamicResource Stroke}"
                    Padding="13,11"
                    Width="170"
                    Height="76"
                    Margin="0,0,0,9">
              <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="11" Background="#4A342B">
                  <TextBlock Text="Y" Foreground="#F3B184" FontSize="16" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                  <TextBlock Text="Hacker News" Foreground="{DynamicResource Text}" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="The latest stories" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,3,0,0" />
                </StackPanel>
              </StackPanel>
            </Button>
          </WrapPanel>
        </StackPanel>
        <TextBlock Text="Your tabs and browsing data stay on this device."
                   Foreground="{DynamicResource Muted}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,0" />
      </StackPanel>

    </Grid>

    <Popup x:Name="NewTabDialog"
           PlacementTarget="{Binding ElementName=BrowserPaneHost}"
           Placement="Center"
           AllowsTransparency="True"
           StaysOpen="True"
           PopupAnimation="Fade">
      <Grid x:Name="NewTabDialogBackdrop"
            Width="{Binding ActualWidth, ElementName=BrowserPaneHost}"
            Height="{Binding ActualHeight, ElementName=BrowserPaneHost}"
            Background="#99000000"
            MouseLeftButtonDown="NewTabDialogBackdrop_MouseLeftButtonDown">
        <Border x:Name="NewTabDialogCard"
                Width="495"
                MaxWidth="495"
                MaxHeight="{Binding ActualHeight, ElementName=BrowserPaneHost}"
                Padding="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource ChromeBg}"
                BorderBrush="{DynamicResource Stroke}"
                BorderThickness="1"
                CornerRadius="18"
                Effect="{DynamicResource PopupShadow}"
                MouseLeftButtonDown="NewTabDialogCard_MouseLeftButtonDown">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="New tab"
                         Foreground="{DynamicResource Text}"
                         FontSize="16"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Content="&#xE711;"
                      Style="{StaticResource IconButton}"
                      Width="26"
                      Height="26"
                      Click="NewTabDialogCancel_Click"
                      ToolTip="Close" />
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Background="{DynamicResource InputBg}"
                      BorderBrush="{DynamicResource StrokeStrong}"
                      BorderThickness="1"
                      CornerRadius="11"
                      Padding="4"
                      Margin="0,0,8,0">
                <Grid MinHeight="42">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE721;"
                             FontFamily="Segoe MDL2 Assets"
                             Foreground="{DynamicResource Muted}"
                             FontSize="14"
                             VerticalAlignment="Center"
                             Margin="10,0,8,0" />
                  <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBox x:Name="NewTabDialogAddressBox"
                             MinHeight="40"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource Text}"
                             CaretBrush="{DynamicResource Accent}"
                             FontSize="13"
                             Padding="0,8"
                             VerticalContentAlignment="Center"
                             ToolTip="Search or enter an address"
                             PreviewKeyDown="NewTabDialogAddressBox_PreviewKeyDown" />
                    <TextBlock Text="Search or enter URL"
                               Foreground="{DynamicResource Muted}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Margin="0,0,4,0">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=NewTabDialogAddressBox}" Value="">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </Grid>
              </Border>
              <Button Grid.Column="1"
                      MinWidth="68"
                      Height="48"
                      Padding="14,0"
                      Background="{DynamicResource Accent}"
                      Foreground="White"
                      BorderThickness="0"
                      Cursor="Hand"
                      Click="NewTabDialogSubmit_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Go"
                             FontSize="12"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                  <TextBlock Text="&#xE72A;"
                             FontFamily="Segoe MDL2 Assets"
                             FontSize="10"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0" />
                </StackPanel>
              </Button>
            </Grid>
            <Border Height="1"
                    Background="{DynamicResource Stroke}"
                    Margin="0,20,0,18" />
            <Grid Margin="0,0,0,16">
              <TextBlock Text="Shortcuts"
                         Foreground="{DynamicResource InkSecondary}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Content="&#xE712;"
                      FontFamily="Segoe MDL2 Assets"
                      Foreground="{DynamicResource Muted}"
                      FontSize="10"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Width="26"
                      Height="24"
                      ToolTip="Customize shortcuts"
                      Click="CustomizeShortcuts_Click" />
            </Grid>
                <StackPanel x:Name="NewTabShortcutsPanel" />
              </StackPanel>
            </ScrollViewer>
        </Border>
      </Grid>
    </Popup>

    <Popup x:Name="ShortcutManagerDialog"
           PlacementTarget="{Binding ElementName=BrowserPaneHost}"
           Placement="Center"
           AllowsTransparency="True"
           StaysOpen="True"
           PopupAnimation="Fade">
      <Grid Width="{Binding ActualWidth, ElementName=BrowserPaneHost}"
            Height="{Binding ActualHeight, ElementName=BrowserPaneHost}"
            Background="#99000000">
        <Border Width="520"
                MaxWidth="520"
                MaxHeight="{Binding ActualHeight, ElementName=BrowserPaneHost}"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource ChromeBg}"
                BorderBrush="{DynamicResource Stroke}"
                BorderThickness="1"
                CornerRadius="16"
                Effect="{DynamicResource PopupShadow}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom">
              <TextBlock x:Name="ShortcutManagerStatus"
                         Foreground="{DynamicResource Muted}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Margin="0,10,0,10" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        MinWidth="84"
                        Margin="0,0,8,0"
                        Style="{StaticResource MicroButton}"
                        Click="ShortcutManagerCancel_Click" />
                <Button Content="Save shortcuts"
                        MinWidth="120"
                        Background="{DynamicResource Accent}"
                        Foreground="White"
                        BorderThickness="0"
                        Click="ShortcutManagerSave_Click" />
              </StackPanel>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
              <TextBlock Text="Customize shortcuts"
                         Foreground="{DynamicResource Text}"
                         FontSize="18"
                         FontWeight="SemiBold" />
              <TextBlock Text="Edit names and URLs, change their order, or remove shortcuts."
                         Foreground="{DynamicResource Muted}"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Margin="0,4,0,14" />
                <Border Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource Stroke}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="10">
                  <StackPanel>
                    <TextBlock Text="Add a shortcut"
                               Foreground="{DynamicResource InkSecondary}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Name"
                                   Foreground="{DynamicResource Muted}"
                                   FontSize="10"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="ShortcutNameInput"
                                 Height="38"
                                 Padding="8,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Website URL"
                                   Foreground="{DynamicResource Muted}"
                                   FontSize="10"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="ShortcutUrlInput"
                                 Height="38"
                                 Padding="8,0" />
                      </StackPanel>
                      <Button Grid.Column="2"
                              Content="Add"
                              MinWidth="55"
                              Height="38"
                              VerticalAlignment="Bottom"
                              Style="{StaticResource MicroButton}"
                              Click="ShortcutManagerAdd_Click" />
                    </Grid>
                  </StackPanel>
                </Border>
                <TextBlock Text="Your shortcuts"
                           Foreground="{DynamicResource InkSecondary}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,14,0,8" />
                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.35*" />
                    <ColumnDefinition Width="0.65*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Name"
                             Foreground="{DynamicResource Muted}"
                             FontSize="10"
                             Margin="8,0,0,0" />
                  <TextBlock Grid.Column="1"
                             Text="Website URL"
                             Foreground="{DynamicResource Muted}"
                             FontSize="10"
                             Margin="8,0,0,0" />
                </Grid>
                <StackPanel x:Name="ShortcutEditorList" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Popup>

  </Grid>
</UserControl>
