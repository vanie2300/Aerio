<UserControl x:Class="TabloidBrowser.BrowserPaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="BrowserPaneHost">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="PrimaryPaneColumn" Width="*" />
      <ColumnDefinition x:Name="SplitPaneDividerColumn" Width="0" />
      <ColumnDefinition x:Name="SplitPaneColumn" Width="0" />
    </Grid.ColumnDefinitions>

    <Grid x:Name="WebViewHost"
          Grid.Column="0"
          Background="{DynamicResource AppBg}" />

    <Grid x:Name="InternalPageHost"
          Grid.Column="0"
          Background="{DynamicResource AppBg}"
          Visibility="Collapsed" />

    <!-- Cross-fade scrim: masks the hard WebView swap (HwndHost can't fade). -->
    <Border x:Name="SwapScrim"
            Grid.Column="0"
            Background="{DynamicResource AppBg}"
            Opacity="0"
            IsHitTestVisible="False" />

    <Grid x:Name="LoadingOverlay"
          Grid.Column="0"
          Visibility="Collapsed"
          Background="{DynamicResource AppBg}"
          IsHitTestVisible="False">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="0,0,0,36">
        <Border Width="36"
                Height="36"
                CornerRadius="18"
                BorderBrush="{DynamicResource Accent}"
                BorderThickness="3"
                Background="Transparent"
                HorizontalAlignment="Center"
                Margin="0,0,0,12"
                RenderTransformOrigin="0.5,0.5">
          <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                   From="0" To="360" Duration="0:0:0.8" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Border.Triggers>
          <Border.RenderTransform>
            <RotateTransform />
          </Border.RenderTransform>
        </Border>
        <Ellipse Width="18"
                 Height="18"
                 Fill="{DynamicResource Accent}"
                 Opacity="0.3"
                 HorizontalAlignment="Center"
                 Margin="0,-50,0,0" />
        <TextBlock x:Name="LoadingTitleText"
                   Text="Loading"
                   Foreground="{DynamicResource Text}"
                   FontSize="22"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8" />
        <TextBlock Text="Preparing page"
                   Foreground="{DynamicResource Muted}"
                   FontSize="12"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>

    <Grid x:Name="StartOverlay"
          Grid.Column="0"
          Visibility="Visible">
      <Canvas x:Name="StartBgCanvas"
              Background="{DynamicResource AppBg}"
              IsHitTestVisible="False"
              Focusable="False" />
      <StackPanel Width="620"
                  x:Name="StartHero"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="0,0,0,40"
                  Opacity="0"
                  RenderTransformOrigin="0.5,0.5">
        <StackPanel.RenderTransform>
          <TranslateTransform Y="20" />
        </StackPanel.RenderTransform>
        <StackPanel.Triggers>
          <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.6"
                                 EasingFunction="{StaticResource CubicEaseOut}" />
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y"
                                 From="20" To="0" Duration="0:0:0.6"
                                 EasingFunction="{StaticResource CubicEaseOut}" />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </StackPanel.Triggers>
        <TextBlock Text="Tabloid"
                   FontFamily="./Assets/Fonts/#Font208, Segoe UI"
                   Foreground="{DynamicResource Text}"
                   FontSize="55"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4">
          <TextBlock.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.3" Color="#724DDF" />
          </TextBlock.Effect>
        </TextBlock>
        <TextBlock Text="Private local search"
                   Foreground="{DynamicResource Muted}"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,18" />
        <Grid Height="40">
          <Border Background="{DynamicResource ChromeAlt}"
                  CornerRadius="8"
                  Margin="0" />
          <Border x:Name="SearchBorder"
                  Background="{DynamicResource ChromeBg}"
                  BorderBrush="{DynamicResource Stroke}"
                  BorderThickness="1"
                  CornerRadius="8"
                  PreviewMouseDown="StartSearchSurface_PreviewMouseDown">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE721;"
                         FontFamily="Segoe MDL2 Assets"
                         Foreground="{DynamicResource Muted}"
                         Margin="14,0,9,0"
                         VerticalAlignment="Center" />
              <TextBox x:Name="StartSearchBox"
                       Grid.Column="1"
                       Background="Transparent"
                       BorderThickness="0"
                       Foreground="{DynamicResource Text}"
                       CaretBrush="{DynamicResource Accent}"
                       FontSize="14"
                       Padding="0,9,10,0"
                       GotKeyboardFocus="StartSearchBox_GotKeyboardFocus"
                       LostKeyboardFocus="StartSearchBox_LostKeyboardFocus"
                       PreviewKeyDown="StartSearchBox_PreviewKeyDown" />
              <Button Grid.Column="2"
                      Content="&#xE721;"
                      Click="StartSearchGo_Click"
                      Style="{StaticResource IconButton}"
                      Background="Transparent"
                      BorderThickness="0"
                      Width="34"
                      Height="30"
                      Margin="0,5,5,5"
                      ToolTip="Search or open address" />
            </Grid>
          </Border>
        </Grid>
        <UniformGrid Columns="4"
                     x:Name="QuickLinksPanel"
                     Margin="0,14,0,0">
          <Button Content="DuckDuckGo"
                  Click="QuickDuckDuckGo_Click"
                  Style="{StaticResource MicroButton}"
                  Height="32"
                  Margin="0,0,8,0" />
          <Button Content="Startpage"
                  Click="QuickStartpage_Click"
                  Style="{StaticResource MicroButton}"
                  Height="32"
                  Margin="0,0,8,0" />
          <Button Content="GitHub"
                  Click="QuickGitHub_Click"
                  Style="{StaticResource MicroButton}"
                  Height="32"
                  Margin="0,0,8,0" />
          <Button Content="HN"
                  Click="QuickHackerNews_Click"
                  Style="{StaticResource MicroButton}"
                  Height="32" />
        </UniformGrid>
      </StackPanel>
    </Grid>

    <GridSplitter x:Name="SplitPaneSplitter"
                  Grid.Column="1"
                  Width="5"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource SubtleStroke}"
                  Cursor="SizeWE"
                  Visibility="Collapsed"
                  IsTabStop="False" />

    <Grid x:Name="SplitPane"
          Grid.Column="2"
          Background="{DynamicResource AppBg}"
          Visibility="Collapsed">
      <Grid x:Name="SplitWebViewHost"
            Background="{DynamicResource AppBg}" />
      <Grid x:Name="SplitLoadingOverlay"
            Visibility="Collapsed"
            Background="{DynamicResource AppBg}"
            IsHitTestVisible="False">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,0,0,36">
          <Border Width="30"
                  Height="30"
                  CornerRadius="15"
                  BorderBrush="{DynamicResource Accent}"
                  BorderThickness="3"
                  Background="Transparent"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,10"
                  RenderTransformOrigin="0.5,0.5">
            <Border.Triggers>
              <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                     From="0" To="360" Duration="0:0:0.8" />
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Border.Triggers>
            <Border.RenderTransform>
              <RotateTransform />
            </Border.RenderTransform>
          </Border>
          <TextBlock Text="Loading"
                     Foreground="{DynamicResource Text}"
                     FontSize="18"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>

      <Border HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,10,10,0"
              Background="{DynamicResource ChromeBg}"
              BorderBrush="{DynamicResource Stroke}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="2">
        <StackPanel Orientation="Horizontal">
          <Button Content="&#xE8A7;"
                  Click="FocusSplitTab_Click"
                  Style="{StaticResource IconButton}"
                  Width="26"
                  Height="24"
                  FontSize="11"
                  ToolTip="Focus split tab" />
          <Button Content="&#xE894;"
                  Click="CloseSplit_Click"
                  Style="{StaticResource IconButton}"
                  Width="26"
                  Height="24"
                  FontSize="10"
                  Margin="2,0,0,0"
                  ToolTip="Close split view" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
