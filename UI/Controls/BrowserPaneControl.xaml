<UserControl x:Class="TabloidBrowser.BrowserPaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TabloidBrowser"
             xmlns:lg="https://liquid-glass-engineering.vercel.app/wpf">
  <UserControl.Resources>
    <LinearGradientBrush x:Key="StartGlassSurface" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#9C322B43" Offset="0" />
      <GradientStop Color="#76231F34" Offset="0.5" />
      <GradientStop Color="#9220192E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StartGlassEdge" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#BDAE83F5" Offset="0" />
      <GradientStop Color="#70C5A9FF" Offset="0.3" />
      <GradientStop Color="#36FFFFFF" Offset="0.68" />
      <GradientStop Color="#70947AD0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StartGlassHighlight" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#24FFFFFF" Offset="0" />
      <GradientStop Color="#0AFFFFFF" Offset="0.45" />
      <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StartGlassAction" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#C08F74DD" Offset="0" />
      <GradientStop Color="#AA7257C1" Offset="1" />
    </LinearGradientBrush>
    <Style x:Key="StartGlassActionButton"
           TargetType="Button"
           BasedOn="{StaticResource IconButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12">
              <Grid>
                <Border x:Name="HoverOverlay"
                        Background="{DynamicResource ButtonHover}"
                        CornerRadius="12"
                        Opacity="0" />
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0.35"
                                       Duration="0:0:0.14" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0"
                                       Duration="0:0:0.2" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.65" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid x:Name="BrowserPaneHost">
    <Grid x:Name="WebViewHost"
          Background="{DynamicResource AppBg}" />

    <Grid x:Name="InternalPageHost"
          Background="{DynamicResource AppBg}"
          Visibility="Collapsed" />

    <!-- Cross-fade scrim: masks the hard WebView swap (HwndHost can't fade). -->
    <Border x:Name="SwapScrim"
            Background="{DynamicResource AppBg}"
            Opacity="0"
            IsHitTestVisible="False" />

    <local:AerioAirLoadingOverlay x:Name="LoadingOverlay" />

    <lg:GlassScene x:Name="StartOverlay"
                   ClipToBounds="True"
                   Visibility="Visible"
                   lg:GlassScene.Material="Regular">
      <lg:GlassScene.Content>
        <Grid x:Name="StartBackdrop"
              Background="{DynamicResource AppBg}">
        <Viewbox x:Name="StartScene"
                 Stretch="UniformToFill"
                 IsHitTestVisible="False">
          <Canvas Width="1365" Height="760">
          <Rectangle Width="1365" Height="760">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#100D1C" Offset="0" />
                <GradientStop Color="#17152A" Offset="0.57" />
                <GradientStop Color="#28203B" Offset="1" />
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
          <Ellipse Canvas.Left="690"
                   Canvas.Top="250"
                   Width="900"
                   Height="470"
                   Opacity="0.72">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#76564070" Offset="0" />
                <GradientStop Color="#383E315B" Offset="0.48" />
                <GradientStop Color="#003E315B" Offset="1" />
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <Path Data="M -90,-18 C 110,7 236,112 408,164 C 610,225 902,203 1114,259 C 1238,292 1340,311 1460,296"
                Stroke="#7A3F2B9A"
                StrokeThickness="15"
                Opacity="0.42">
            <Path.Effect>
              <BlurEffect Radius="24" />
            </Path.Effect>
          </Path>
          <Path Data="M -90,-18 C 110,7 236,112 408,164 C 610,225 902,203 1114,259 C 1238,292 1340,311 1460,296"
                Stroke="#9B6647C7"
                StrokeThickness="2"
                Opacity="0.72" />
          <Path Data="M -30,558 C 92,527 137,480 218,496 C 296,513 336,464 421,482 C 504,501 548,535 620,502 C 695,468 735,481 799,506 C 873,534 924,479 1007,494 C 1090,510 1125,466 1200,480 C 1270,493 1318,531 1400,505 L 1400,790 L -30,790 Z">
            <Path.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#302943" Offset="0" />
                <GradientStop Color="#1C1A30" Offset="0.55" />
                <GradientStop Color="#131421" Offset="1" />
              </LinearGradientBrush>
            </Path.Fill>
          </Path>
          <Path Data="M -30,608 C 62,586 135,548 216,563 C 301,579 363,530 440,552 C 526,576 564,601 645,568 C 718,538 774,560 841,579 C 919,600 970,538 1048,552 C 1120,566 1173,523 1244,548 C 1311,571 1340,585 1400,565 L 1400,790 L -30,790 Z"
                Fill="#211E36" />
          <Path Data="M -30,672 C 73,643 129,602 218,622 C 305,642 363,592 446,614 C 525,635 589,666 671,635 C 753,604 804,624 881,650 C 951,673 1007,613 1083,625 C 1163,638 1212,591 1291,615 C 1341,630 1370,648 1400,642 L 1400,790 L -30,790 Z"
                Fill="#17182D" />
          <Path Data="M -30,738 C 57,707 130,681 215,699 C 293,716 366,672 445,694 C 527,716 586,747 670,714 C 750,682 821,698 891,723 C 970,751 1027,688 1107,703 C 1187,719 1252,669 1324,693 C 1360,705 1380,714 1400,709 L 1400,790 L -30,790 Z"
                Fill="#111321" />
          <Path Data="M -20,570 C 205,535 286,526 450,546 S 759,576 928,548 S 1214,525 1385,550"
                Stroke="#8974A8"
                StrokeThickness="1.5"
                Opacity="0.18" />
          <Path Data="M -20,636 C 179,599 294,598 462,620 S 753,654 931,621 S 1208,601 1385,625"
                Stroke="#78658F"
                StrokeThickness="1.2"
                Opacity="0.13" />
          </Canvas>
        </Viewbox>
        <Canvas x:Name="StartBgCanvas"
                Background="Transparent"
                IsHitTestVisible="False"
                Focusable="False" />
        <Border x:Name="StartHeroScrim"
                Width="680"
                Height="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,20,0,32"
                IsHitTestVisible="False">
          <Border.Background>
            <RadialGradientBrush Center="0.5,0.44"
                                 GradientOrigin="0.5,0.44"
                                 RadiusX="0.52"
                                 RadiusY="0.5">
              <GradientStop Color="#55100E1B" Offset="0" />
              <GradientStop Color="#25100E1B" Offset="0.68" />
              <GradientStop Color="#00100E1B" Offset="1" />
            </RadialGradientBrush>
          </Border.Background>
        </Border>
        </Grid>
      </lg:GlassScene.Content>
      <StackPanel x:Name="StartHero"
                  MaxWidth="680"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="32,0,32,0"
                  TextElement.FontFamily="Segoe UI"
                  Opacity="1"
                  RenderTransformOrigin="0.5,0.5">
        <StackPanel.RenderTransform>
          <TranslateTransform Y="0" />
        </StackPanel.RenderTransform>
        <StackPanel HorizontalAlignment="Center"
                    Margin="0,0,0,14">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Aerio"
                       Foreground="{DynamicResource Text}"
                       FontSize="22"
                       FontWeight="Medium"
                       VerticalAlignment="Center"
                       Margin="0" />
          </StackPanel>
        </StackPanel>
        <TextBlock FontFamily="Segoe UI"
                   Foreground="{DynamicResource Text}"
                   FontSize="32"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10">
          <Run Text="Where will " />
          <Run Text="curiosity"
               Foreground="{DynamicResource Accent}"
               FontStyle="Normal" />
          <Run Text=" take you?" />
        </TextBlock>
        <TextBlock Text="Search the web or enter a URL."
                   Foreground="{DynamicResource Muted}"
                   FontSize="14"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,28" />
        <lg:GlassSurface x:Name="SearchBorder"
                MaxWidth="620"
                HorizontalAlignment="Stretch"
                Material="Regular"
                IsInteractive="True"
                Radius="20"
                Height="60"
                Padding="6"
                PreviewMouseDown="StartSearchSurface_PreviewMouseDown">
          <Grid MinHeight="42" ClipToBounds="True">
            <Grid MinHeight="42">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE721;"
                         FontFamily="Segoe MDL2 Assets"
                         Foreground="{DynamicResource Text}"
                         FontSize="18"
                         VerticalAlignment="Center"
                         Margin="10,0,16,0" />
              <Grid Grid.Column="1" VerticalAlignment="Center">
                <TextBox x:Name="StartSearchBox"
                         Height="42"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="Segoe UI"
                         Foreground="{DynamicResource Text}"
                         CaretBrush="{DynamicResource Accent}"
                         FontSize="14"
                         Padding="0,0,10,0"
                         VerticalContentAlignment="Center"
                         GotKeyboardFocus="StartSearchBox_GotKeyboardFocus"
                         LostKeyboardFocus="StartSearchBox_LostKeyboardFocus"
                         PreviewKeyDown="StartSearchBox_PreviewKeyDown" />
                <TextBlock Text="Search or enter a web address..."
                           FontFamily="Segoe UI"
                           Foreground="{DynamicResource Muted}"
                           FontSize="14"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Margin="0,0,8,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=StartSearchBox}" Value="">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
              <Button Grid.Column="2"
                      Content="&#xE72A;"
                      Click="StartSearchGo_Click"
                      Margin="0,0,6,0"
                      Style="{StaticResource StartGlassActionButton}"
                      Background="{DynamicResource StartGlassAction}"
                      BorderBrush="#6EFFFFFF"
                      BorderThickness="1"
                      Foreground="White"
                      Width="38"
                      Height="38"
                      FontSize="15"
                      ToolTip="Search or open address"
                      AutomationProperties.Name="Search or open address" />
            </Grid>
          </Grid>
        </lg:GlassSurface>
        <StackPanel x:Name="NewTabQuickLinksSection"
                    Margin="0,28,0,0">
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Quick links"
                       Foreground="{DynamicResource InkSecondary}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="&#xE712;"
                    Style="{StaticResource IconButton}"
                    Width="36"
                    Height="32"
                    Click="CustomizeShortcuts_Click"
                    ToolTip="Edit quick links"
                    AutomationProperties.Name="Edit quick links" />
          </Grid>
          <StackPanel x:Name="NewTabHeroShortcutsPanel" />
        </StackPanel>
      </StackPanel>

    </lg:GlassScene>

    <Popup x:Name="NewTabDialog"
           PlacementTarget="{Binding ElementName=BrowserPaneHost}"
           Placement="Center"
           AllowsTransparency="True"
           StaysOpen="True"
           PopupAnimation="Fade">
      <Grid x:Name="NewTabDialogBackdrop"
            Width="{Binding ActualWidth, ElementName=BrowserPaneHost}"
            Height="{Binding ActualHeight, ElementName=BrowserPaneHost}"
            Background="#99000000"
            MouseLeftButtonDown="NewTabDialogBackdrop_MouseLeftButtonDown">
        <Border x:Name="NewTabDialogCard"
                MaxWidth="640"
                MaxHeight="{Binding ActualHeight, ElementName=BrowserPaneHost}"
                Padding="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource GlassSurface}"
                BorderBrush="{DynamicResource GlassEdge}"
                BorderThickness="1"
                CornerRadius="8"
                Effect="{DynamicResource PopupShadow}"
                MouseLeftButtonDown="NewTabDialogCard_MouseLeftButtonDown">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="New tab"
                         Foreground="{DynamicResource Text}"
                         FontSize="16"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Content="&#xE711;"
                      Style="{StaticResource IconButton}"
                      Width="26"
                      Height="26"
                      Click="NewTabDialogCancel_Click"
                      ToolTip="Close" />
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Background="{DynamicResource GlassInset}"
                      BorderBrush="{DynamicResource GlassEdge}"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="4"
                      Margin="0,0,8,0">
                <Grid MinHeight="42">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE721;"
                             FontFamily="Segoe MDL2 Assets"
                             Foreground="{DynamicResource Muted}"
                             FontSize="14"
                             VerticalAlignment="Center"
                             Margin="10,0,8,0" />
                  <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBox x:Name="NewTabDialogAddressBox"
                             MinHeight="40"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource Text}"
                             CaretBrush="{DynamicResource Accent}"
                             FontSize="13"
                             Padding="0,8"
                             VerticalContentAlignment="Center"
                             ToolTip="Search or enter an address"
                             PreviewKeyDown="NewTabDialogAddressBox_PreviewKeyDown" />
                    <TextBlock Text="Search or enter URL"
                               Foreground="{DynamicResource Muted}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Margin="0,0,4,0">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=NewTabDialogAddressBox}" Value="">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </Grid>
              </Border>
              <Button Grid.Column="1"
                      MinWidth="68"
                      Height="48"
                      Padding="14,0"
                      Background="{DynamicResource Accent}"
                      Foreground="White"
                      BorderThickness="0"
                      Cursor="Hand"
                      Click="NewTabDialogSubmit_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Go"
                             FontSize="12"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                  <TextBlock Text="&#xE72A;"
                             FontFamily="Segoe MDL2 Assets"
                             FontSize="10"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0" />
                </StackPanel>
              </Button>
            </Grid>
            <Border Height="1"
                    Background="{DynamicResource Stroke}"
                    Margin="0,20,0,18" />
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Shortcuts"
                         Foreground="{DynamicResource InkSecondary}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Content="&#xE712;"
                      FontFamily="Segoe MDL2 Assets"
                      Foreground="{DynamicResource Muted}"
                      FontSize="10"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Width="26"
                      Height="24"
                      ToolTip="Customize shortcuts"
                      Click="CustomizeShortcuts_Click" />
            </Grid>
                <StackPanel x:Name="NewTabShortcutsPanel" />
              </StackPanel>
            </ScrollViewer>
        </Border>
      </Grid>
    </Popup>

    <Popup x:Name="ShortcutManagerDialog"
           PlacementTarget="{Binding ElementName=BrowserPaneHost}"
           Placement="Center"
           AllowsTransparency="True"
           StaysOpen="True"
           PopupAnimation="Fade">
      <Grid Width="{Binding ActualWidth, ElementName=BrowserPaneHost}"
            Height="{Binding ActualHeight, ElementName=BrowserPaneHost}"
            Background="#99000000">
        <Border Width="680"
                MaxWidth="680"
                MaxHeight="{Binding ActualHeight, ElementName=BrowserPaneHost}"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource GlassSurface}"
                BorderBrush="{DynamicResource GlassEdge}"
                BorderThickness="1"
                CornerRadius="8"
                Effect="{DynamicResource PopupShadow}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom">
              <TextBlock x:Name="ShortcutManagerStatus"
                         Foreground="{DynamicResource Muted}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Margin="0,10,0,10" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        MinWidth="84"
                        Margin="0,0,8,0"
                        Style="{StaticResource MicroButton}"
                        Click="ShortcutManagerCancel_Click" />
                <Button Content="Save shortcuts"
                        MinWidth="120"
                        Background="{DynamicResource Accent}"
                        Foreground="White"
                        BorderThickness="0"
                        Click="ShortcutManagerSave_Click" />
              </StackPanel>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
              <TextBlock Text="Customize shortcuts"
                         Foreground="{DynamicResource Text}"
                         FontSize="18"
                         FontWeight="SemiBold" />
              <TextBlock Text="Edit names, website URLs and optional icon URLs, change their order, or remove shortcuts."
                         Foreground="{DynamicResource Muted}"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Margin="0,4,0,14" />
                <Border Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource Stroke}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="10">
                  <StackPanel>
                    <TextBlock Text="Add a shortcut"
                               Foreground="{DynamicResource InkSecondary}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Name"
                                   Foreground="{DynamicResource Muted}"
                                   FontSize="10"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="ShortcutNameInput"
                                 Height="38"
                                 Padding="8,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Website URL"
                                   Foreground="{DynamicResource Muted}"
                                   FontSize="10"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="ShortcutUrlInput"
                                 Height="38"
                                 Padding="8,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Icon URL (optional)"
                                   Foreground="{DynamicResource Muted}"
                                   FontSize="10"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="ShortcutIconInput"
                                 Height="38"
                                 Padding="8,0"
                                 ToolTip="Optional HTTP or HTTPS image URL" />
                      </StackPanel>
                      <Button Grid.Column="3"
                              Content="Add"
                              MinWidth="55"
                              Height="38"
                              VerticalAlignment="Bottom"
                              Style="{StaticResource MicroButton}"
                              Click="ShortcutManagerAdd_Click" />
                    </Grid>
                  </StackPanel>
                </Border>
                <TextBlock Text="Your shortcuts"
                           Foreground="{DynamicResource InkSecondary}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,14,0,8" />
                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.24*" />
                    <ColumnDefinition Width="0.42*" />
                    <ColumnDefinition Width="0.34*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Name"
                             Foreground="{DynamicResource Muted}"
                             FontSize="10"
                             Margin="8,0,0,0" />
                  <TextBlock Grid.Column="1"
                             Text="Website URL"
                             Foreground="{DynamicResource Muted}"
                             FontSize="10"
                             Margin="8,0,0,0" />
                  <TextBlock Grid.Column="2"
                             Text="Icon URL"
                             Foreground="{DynamicResource Muted}"
                             FontSize="10"
                             Margin="8,0,0,0" />
                </Grid>
                <StackPanel x:Name="ShortcutEditorList" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Popup>

  </Grid>
</UserControl>
