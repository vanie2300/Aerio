<UserControl x:Class="TabloidBrowser.NavToolbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TabloidBrowser">
  <Border Background="{DynamicResource GlassSurface}"
          ClipToBounds="True"
          BorderBrush="{DynamicResource GlassEdge}"
          BorderThickness="0,0,0,1">
    <Grid Margin="8,3,8,3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="36" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0"
                  Grid.Column="0"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0">
        <Button x:Name="BackButton"
                Content="&#xE72B;"
                Click="Back_Click"
                Style="{StaticResource IconButton}"
                ToolTip="Back" />
        <Button x:Name="ForwardButton"
                Content="&#xE72A;"
                Click="Forward_Click"
                Style="{StaticResource IconButton}"
                Margin="4,0,0,0"
                ToolTip="Forward" />
        <Button x:Name="ReloadButton"
                Content="&#xE72C;"
                Click="Reload_Click"
                Style="{StaticResource IconButton}"
                Margin="4,0,0,0"
                ToolTip="Reload" />
        <Button x:Name="HomeButton"
                Content="&#xE80F;"
                Click="Home_Click"
                Style="{StaticResource IconButton}"
                Margin="4,0,0,0"
                ToolTip="Start page" />
      </StackPanel>

      <Border Grid.Row="0"
              Grid.Column="1"
              Margin="0,0,0,0"
              Background="{DynamicResource GlassInset}"
              BorderBrush="{DynamicResource GlassEdge}"
              BorderThickness="1"
              CornerRadius="7"
              Height="36"
              VerticalAlignment="Center">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button x:Name="PrivacyButton"
                  Grid.Column="0"
                  Content="&#xE83D;"
                  Click="Privacy_Click"
                  Style="{StaticResource IconButton}"
                  Foreground="{DynamicResource Lime}"
                  FontSize="14"
                  BorderThickness="0"
                  Width="30"
                  ToolTip="Privacy permissions" />
          <Image x:Name="AddressFavicon"
                 Grid.Column="1"
                 Width="16"
                 Height="16"
                 Stretch="Uniform"
                 VerticalAlignment="Center"
                 Margin="2,0,0,0"
                 Visibility="Collapsed"
                 IsHitTestVisible="False" />
          <TextBox x:Name="AddressBox"
                   Grid.Column="2"
                   Background="Transparent"
                   BorderThickness="0"
                   Foreground="{DynamicResource Text}"
                   CaretBrush="{DynamicResource Accent}"
                   FontSize="13"
                   Padding="2,0,8,0"
                   VerticalContentAlignment="Center"
                   TextChanged="AddressBox_TextChanged"
                   GotKeyboardFocus="AddressBox_GotKeyboardFocus"
                   LostKeyboardFocus="AddressBox_LostKeyboardFocus"
                   PreviewMouseLeftButtonDown="AddressBox_PreviewMouseLeftButtonDown"
                   PreviewKeyDown="AddressBox_PreviewKeyDown" />
          <Button x:Name="BookmarkStarBtn"
                  Grid.Column="3"
                  Content="&#xE734;"
                  Click="Bookmark_Click"
                  Style="{StaticResource IconButton}"
                  FontSize="12"
                  BorderThickness="0"
                  Width="26"
                  Height="30"
                  Margin="2,0,0,0"
                  ToolTip="Bookmark this page"
                  Visibility="Collapsed" />
          <Button x:Name="GoBtn"
                  Grid.Column="4"
                  Content="Go"
                  Click="Go_Click"
                  IsDefault="True"
                  Style="{StaticResource MicroButton}"
                  BorderBrush="{DynamicResource SubtleStroke}"
                  Margin="0,0,3,0"
                  Height="26"
                  ToolTip="Go to address"
                  Visibility="Collapsed" />
        </Grid>
      </Border>

      <Popup x:Name="AddressSuggestionsPopup"
             PlacementTarget="{Binding ElementName=AddressBox}"
             Placement="Bottom"
             StaysOpen="False"
             AllowsTransparency="True"
             PopupAnimation="Fade">
        <Border x:Name="AddressSuggestionsBorder"
                Background="{DynamicResource GlassSurface}"
                BorderBrush="{DynamicResource GlassEdge}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="4"
                Effect="{DynamicResource PopupShadow}"
                MaxHeight="320">
          <ListBox x:Name="AddressSuggestionsList"
                   Background="Transparent"
                   BorderThickness="0"
                   MaxHeight="318"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   MouseLeftButtonUp="AddressSuggestions_MouseLeftButtonUp">
            <ListBox.Resources>
              <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}" />
            </ListBox.Resources>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="SuggestionRoot"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="5"
                              Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="SuggestionRoot" Property="Background" Value="{DynamicResource ButtonHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="SuggestionRoot" Property="Background" Value="{DynamicResource ButtonPressed}" />
                          <Setter TargetName="SuggestionRoot" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               Foreground="{DynamicResource Text}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Url}"
                               Foreground="{DynamicResource Muted}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Border Grid.Column="1"
                          Background="{DynamicResource ChromeAlt}"
                          BorderBrush="{DynamicResource SubtleStroke}"
                          BorderThickness="1"
                          CornerRadius="5"
                          Padding="7,3"
                          VerticalAlignment="Center"
                          Margin="12,0,0,0">
                    <TextBlock Text="{Binding Source}"
                               Foreground="{DynamicResource Muted}"
                               FontSize="10" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Popup>

      <StackPanel Grid.Row="0"
                  Grid.Column="2"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Margin="8,0,0,0">
        <Button x:Name="ReaderButton"
                Content="&#xE8B9;"
                Click="ReaderMode_Click"
                Style="{StaticResource IconButton}"
                Margin="4,0,0,0"
                ToolTip="Toggle reader mode"
                Visibility="Collapsed" />
        <Button x:Name="PrivateButton"
                Content="PVT"
                Click="Private_Click"
                Style="{StaticResource MicroButton}"
                BorderBrush="{DynamicResource Pink}"
                Margin="4,0,0,0"
                ToolTip="Open private window"
                Visibility="Collapsed" />
        <local:MediaControlChip x:Name="MediaChip"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center" />
        <Rectangle Width="1"
                   Height="16"
                   Fill="{DynamicResource SubtleStroke}"
                   Margin="8,0"
                   VerticalAlignment="Center" />
        <Button x:Name="AiToggleButton"
                Content="AI"
                Click="AiToggle_Click"
                Style="{StaticResource MicroButton}"
                BorderBrush="{DynamicResource SubtleStroke}"
                Margin="0,0,0,0"
                ToolTip="Toggle AI chat sidebar"
                Visibility="Visible" />
        <Button x:Name="MemoryButton"
                Content="RAM"
                Click="SleepTabs_Click"
                Style="{StaticResource MicroButton}"
                BorderBrush="{DynamicResource SubtleStroke}"
                Margin="4,0,0,0"
                ToolTip="Click to hibernate all inactive tabs"
                Visibility="Visible">
          <Button.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
          </Button.RenderTransform>
          <Button.RenderTransformOrigin>
            <Point X="0.5" Y="0.5" />
          </Button.RenderTransformOrigin>
        </Button>
        <Rectangle Width="1"
                   Height="16"
                   Fill="{DynamicResource SubtleStroke}"
                   Margin="8,0"
                   VerticalAlignment="Center" />
        <Button x:Name="MenuButton"
                Content="&#xE700;"
                Click="Menu_Click"
                Style="{StaticResource IconButton}"
                Margin="0,0,0,0"
                ToolTip="Menu">
          <Button.ContextMenu>
            <ContextMenu x:Name="BrowserMenu"
                         Style="{StaticResource BrowserContextMenuStyle}"
                         Placement="Bottom">
              <MenuItem Header="New tab"
                        Icon="&#xE710;"
                        Style="{StaticResource BrowserMenuItemStyle}"
                        Click="NewTab_Click" />
              <Separator Style="{StaticResource BrowserMenuSeparatorStyle}" />
              <MenuItem Header="Back"
                        Icon="&#xE72B;"
                        Style="{StaticResource BrowserMenuItemStyle}"
                        Click="Back_Click" />
              <MenuItem Header="Forward"
                        Icon="&#xE72A;"
                        Style="{StaticResource BrowserMenuItemStyle}"
                        Click="Forward_Click" />
              <MenuItem Header="Reload"
                        Icon="&#xE72C;"
                        Style="{StaticResource BrowserMenuItemStyle}"
                        Click="Reload_Click" />
              <MenuItem Header="Reader mode"
                        Icon="&#xE8B9;"
                        Style="{StaticResource BrowserMenuItemStyle}"
                        IsCheckable="True"
                        x:Name="ReaderModeMenuItem"
                        Click="ReaderMode_Click"
                        Visibility="Collapsed" />
              <MenuItem Header="Full screen"
                        Icon="&#xE740;"
                        Style="{StaticResource BrowserMenuItemStyle}"
                        Click="FullScreen_Click" />
              <Separator Style="{StaticResource BrowserMenuSeparatorStyle}" />
              <MenuItem Header="Home (start page)"
                        Icon="&#xE80F;"
                        Style="{StaticResource BrowserMenuItemStyle}"
                        Click="Home_Click" />
              <MenuItem Header="Bookmark this page"
                        Icon="&#xE734;"
                        Style="{StaticResource BrowserMenuItemStyle}"
                        Click="Bookmark_Click" />
              <MenuItem x:Name="ForceDarkMenuItem"
                        Header="Force dark page"
                        Icon="&#xE7B8;"
                        Style="{StaticResource BrowserMenuItemStyle}"
                        IsCheckable="True"
                        Checked="ForceDarkMenu_Checked"
                        Unchecked="ForceDarkMenu_Unchecked" />
              <MenuItem Header="Find in page"
                        Icon="&#xE81E;"
                        Style="{StaticResource BrowserMenuItemStyle}"
                        Click="FindInPage_Click" />
              <MenuItem Header="Print"
                        Icon="&#xE914;"
                        Style="{StaticResource BrowserMenuItemStyle}"
                        Click="Print_Click" />
              <MenuItem Header="Library"
                        Icon="&#xE8A4;"
                        Style="{StaticResource BrowserMenuItemStyle}">
                <MenuItem Header="Bookmarks"
                          Icon="&#xE8A4;"
                          Style="{StaticResource BrowserSubMenuItemStyle}"
                          Click="ShowBookmarks_Click" />
                <MenuItem Header="History"
                          Icon="&#xE81C;"
                          Style="{StaticResource BrowserSubMenuItemStyle}"
                          Click="ShowHistory_Click" />
                <MenuItem Header="Downloads"
                          Icon="&#xE896;"
                          Style="{StaticResource BrowserSubMenuItemStyle}"
                          Click="ShowDownloads_Click" />
                <MenuItem Header="Extensions"
                          Icon="&#xE7B9;"
                          Style="{StaticResource BrowserSubMenuItemStyle}"
                          Click="ShowExtensions_Click" />
              </MenuItem>
              <MenuItem Header="Zoom"
                        Icon="&#xE790;"
                        Style="{StaticResource BrowserMenuItemStyle}">
                <MenuItem Header="Zoom in"
                          Icon="&#xE7A1;"
                          Style="{StaticResource BrowserSubMenuItemStyle}"
                          Click="ZoomIn_Click" />
                <MenuItem Header="Zoom out"
                          Icon="&#xE7A0;"
                          Style="{StaticResource BrowserSubMenuItemStyle}"
                          Click="ZoomOut_Click" />
                <MenuItem Header="Reset zoom"
                          Icon="&#xE777;"
                          Style="{StaticResource BrowserSubMenuItemStyle}"
                          Click="ResetZoom_Click" />
              </MenuItem>
              <MenuItem Header="Privacy &amp; data"
                        Icon="&#xE77B;"
                        Style="{StaticResource BrowserMenuItemStyle}">
                <MenuItem Header="Privacy settings"
                          Icon="&#xE83D;"
                          Style="{StaticResource BrowserSubMenuItemStyle}"
                          Click="Privacy_Click" />
                <MenuItem Header="Open private window"
                          Icon="&#xE708;"
                          Style="{StaticResource BrowserSubMenuItemStyle}"
                          Click="Private_Click" />
                <MenuItem Header="Clear browsing data"
                          Icon="&#xE75C;"
                          Style="{StaticResource BrowserSubMenuItemStyle}"
                          Click="ClearData_Click" />
                <MenuItem Header="Cookies &amp; site data"
                          Icon="&#xE825;"
                          Style="{StaticResource BrowserSubMenuItemStyle}"
                          Click="SiteData_Click" />
                <Separator Style="{StaticResource BrowserMenuSeparatorStyle}" />
                <MenuItem x:Name="UblockMenuItem"
                          Header="uBlock Origin"
                          Icon="&#xE7B9;"
                          Style="{StaticResource BrowserSubMenuItemStyle}"
                          IsCheckable="True"
                          Click="UblockToggle_Click" />
              </MenuItem>
              <MenuItem Header="Tools"
                        Icon="&#xE8B2;"
                        Style="{StaticResource BrowserMenuItemStyle}">
                <MenuItem Header="Capture screenshot"
                          Icon="&#xE722;"
                          Style="{StaticResource BrowserSubMenuItemStyle}"
                          Click="CaptureScreenshot_Click" />
                <MenuItem Header="Picture-in-Picture"
                          Icon="&#xE8B9;"
                          Style="{StaticResource BrowserSubMenuItemStyle}"
                          Click="PictureInPicture_Click" />
                <MenuItem Header="Hide / restore browser UI"
                          Icon="&#xE8A7;"
                          Style="{StaticResource BrowserSubMenuItemStyle}"
                          Click="ToggleBrowserChrome_Click" />
                <MenuItem Header="Hibernate inactive tabs"
                          Icon="&#xE90D;"
                          Style="{StaticResource BrowserSubMenuItemStyle}"
                          Click="SleepTabs_Click" />
                <MenuItem Header="AI Chat"
                          Icon="&#xE710;"
                          Style="{StaticResource BrowserSubMenuItemStyle}"
                          Click="AiToggle_Click" />
              </MenuItem>
              <Separator Style="{StaticResource BrowserMenuSeparatorStyle}" />
              <MenuItem Header="Settings"
                        Icon="&#xE713;"
                        Style="{StaticResource BrowserMenuItemStyle}"
                        Click="ShowSettings_Click" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </StackPanel>

    </Grid>
  </Border>
</UserControl>
