<UserControl x:Class="TabloidBrowser.StatusBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="420"
             MaxWidth="640">
  <Popup x:Name="ToastPopup"
         Placement="Relative"
         AllowsTransparency="True"
         IsHitTestVisible="False"
         StaysOpen="True"
         PopupAnimation="Fade">
    <Border x:Name="ToastSurface"
            Width="420"
            Background="{DynamicResource GlassSurface}"
            BorderBrush="{DynamicResource GlassEdge}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16,11"
            Effect="{DynamicResource PopupShadow}">
      <TextBox x:Name="StatusText"
               Background="Transparent"
               BorderThickness="0"
               Foreground="{DynamicResource Text}"
               FontSize="12"
               TextWrapping="Wrap"
               TextAlignment="Center"
               IsReadOnly="True"
               Focusable="False"
               IsTabStop="False"
               HorizontalAlignment="Stretch" />
    </Border>
  </Popup>
</UserControl>
