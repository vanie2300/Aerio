<UserControl x:Class="TabloidBrowser.DownloadShelfControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">

  <UserControl.Resources>
    <Style x:Key="ShelfProgressBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="4" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="Background" Value="{DynamicResource SubtleStroke}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border Background="{TemplateBinding Background}" CornerRadius="2" />
              <Border x:Name="PART_Track" Background="Transparent" />
              <Border x:Name="PART_Indicator"
                      HorizontalAlignment="Left"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="2" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border Background="{DynamicResource GlassSurface}"
          BorderBrush="{DynamicResource GlassEdge}"
          BorderThickness="1"
          CornerRadius="10"
          Width="380"
          MaxHeight="340"
          Effect="{DynamicResource PopupShadow}">
    <Grid Margin="12,10,12,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,8">
        <TextBlock Text="Downloads"
                   Foreground="{DynamicResource Text}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Show all"
                  Click="ShowAll_Click"
                  Style="{StaticResource IconButton}"
                  FontFamily="Segoe UI"
                  FontSize="11"
                  Width="Auto"
                  Height="24"
                  Padding="8,0"
                  Foreground="{DynamicResource Muted}"
                  ToolTip="Open the downloads page" />
          <Button Content="&#xE711;"
                  Click="Dismiss_Click"
                  Style="{StaticResource IconButton}"
                  Width="26"
                  Height="24"
                  FontSize="10"
                  Margin="4,0,0,0"
                  ToolTip="Hide downloads" />
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Row="1"
                    MaxHeight="270"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="ItemsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="&#xE896;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="{DynamicResource Accent}"
                           VerticalAlignment="Center"
                           Margin="0,0,9,0" />

                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding FileName}"
                             Foreground="{DynamicResource Text}"
                             FontSize="12"
                             TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding SourceUrl}" />
                  <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                               Maximum="100"
                               Margin="0,5,0,4">
                    <ProgressBar.Style>
                      <Style TargetType="ProgressBar" BasedOn="{StaticResource ShelfProgressBar}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsIndeterminate}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ProgressBar.Style>
                  </ProgressBar>
                  <TextBlock Foreground="{DynamicResource Muted}"
                             FontSize="10.5">
                    <Run Text="{Binding StateText, Mode=OneWay}" />
                    <Run Text="&#160;&#183;&#160;" />
                    <Run Text="{Binding SizeText, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                  <Button Content="&#xE838;"
                          Click="Reveal_Click"
                          Width="26"
                          Height="26"
                          FontSize="12"
                          ToolTip="Show in folder">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding State}" Value="Completed">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <Button Click="PrimaryAction_Click"
                          Width="26"
                          Height="26"
                          FontSize="12">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                        <Setter Property="Content" Value="&#xE711;" />
                        <Setter Property="ToolTip" Value="Cancel download" />
                        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding State}" Value="Completed">
                            <Setter Property="Content" Value="&#xE8E5;" />
                            <Setter Property="ToolTip" Value="Open file" />
                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding State}" Value="Interrupted">
                            <Setter Property="Content" Value="&#xE74D;" />
                            <Setter Property="ToolTip" Value="Remove from list" />
                            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
