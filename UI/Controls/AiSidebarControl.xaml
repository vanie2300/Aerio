<UserControl x:Class="TabloidBrowser.AiSidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border x:Name="AiSidebarRoot"
          Background="{DynamicResource ChromeBg}"
          BorderBrush="{DynamicResource Stroke}"
          BorderThickness="1,0,0,0"
          Visibility="Collapsed">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              BorderBrush="{DynamicResource SubtleStroke}"
              BorderThickness="0,0,0,1">
        <Grid Margin="10,0,6,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                     Text="AI Chat"
                     Foreground="{DynamicResource Text}"
                     FontSize="14"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="AiClearChatBtn"
                    Content="&#xE74D;"
                    Click="AiClearChat_Click"
                    Style="{StaticResource IconButton}"
                    Width="28"
                    Height="26"
                    FontSize="10"
                    ToolTip="Clear chat history" />
            <Button x:Name="AiSidebarCloseButton"
                    Content="&#xE894;"
                    Click="AiSidebarClose_Click"
                    Style="{StaticResource IconButton}"
                    Width="28"
                    Height="26"
                    FontSize="10"
                    ToolTip="Close AI sidebar" />
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1"
                    x:Name="AiMessagesScroll"
                    VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}" />
        </ScrollViewer.Resources>
        <StackPanel x:Name="AiMessagesStack"
                    Margin="10,8,10,8" />
      </ScrollViewer>

      <Border Grid.Row="2"
              BorderBrush="{DynamicResource SubtleStroke}"
              BorderThickness="0,1,0,0"
              Padding="8,6,8,8">
        <StackPanel>
          <StackPanel Orientation="Horizontal"
                      Margin="0,0,0,4">
            <ToggleButton x:Name="AiPageContextToggle"
                          Content="&#xE774;"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="11"
                          Width="26"
                          Height="20"
                          IsChecked="True"
                          ToolTip="Include page content for context"
                          BorderThickness="1,1,0,1"
                          Background="{DynamicResource ButtonBg}"
                          BorderBrush="{DynamicResource SubtleStroke}"
                          Padding="0"
                          Foreground="{DynamicResource Muted}" />
            <TextBlock Text="Include page"
                       Foreground="{DynamicResource Muted}"
                       FontSize="10"
                       VerticalAlignment="Center"
                       Margin="4,0,0,0" />
          </StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="{DynamicResource InputBg}"
                    BorderBrush="{DynamicResource Stroke}"
                    BorderThickness="1"
                    CornerRadius="6"
                    VerticalAlignment="Center">
              <TextBox x:Name="AiInputBox"
                       Background="Transparent"
                       BorderThickness="0"
                       Foreground="{DynamicResource Text}"
                       CaretBrush="{DynamicResource Cyan}"
                       FontSize="13"
                       Padding="8,6,8,6"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MaxHeight="80"
                       VerticalScrollBarVisibility="Auto"
                       PreviewKeyDown="AiInput_PreviewKeyDown" />
            </Border>
            <Button x:Name="AiSendBtn"
                    Grid.Column="1"
                    Content="&#xE725;"
                    Click="AiSend_Click"
                    Style="{StaticResource IconButton}"
                    Width="30"
                    Height="30"
                    Margin="6,0,0,0"
                    FontSize="14"
                    ToolTip="Send message" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
