<Window x:Class="TabloidBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:TabloidBrowser"
        Icon="/Aerio;component/Assets/Aerio.ico"
        Title="Aerio"
        Width="1280"
        Height="760"
        MinWidth="940"
        MinHeight="540"
        Background="{DynamicResource AppBg}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        ResizeBorderThickness="10"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/SharedResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid x:Name="WindowContentHost" Background="{DynamicResource AppBg}">
    <Grid x:Name="RootGrid" Background="{DynamicResource AppBg}" Opacity="0">
    <Grid.RowDefinitions>
      <RowDefinition x:Name="TitleBarRow" Height="38" />
      <RowDefinition x:Name="NavToolbarRow" Height="42" />
      <RowDefinition x:Name="BrowserContentRow" Height="*" />
    </Grid.RowDefinitions>

    <local:TitleBarControl Grid.Row="0" x:Name="TitleBar" />
    <local:NavToolbarControl Grid.Row="1" x:Name="NavToolbar" />

    <Grid Grid.Row="2"
          x:Name="BrowserHost"
          Panel.ZIndex="0"
          Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="AiSidebarColumn" Width="0" />
      </Grid.ColumnDefinitions>

      <local:BrowserPaneControl Grid.Column="0"
                                x:Name="BrowserPane" />

      <GridSplitter x:Name="AiSplitter"
                    Grid.Column="1"
                    Width="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    IsTabStop="False"
                    ToolTip="Drag to resize sidebar"
                    Cursor="SizeWE"
                    Visibility="Collapsed"
                    DragCompleted="AiSplitter_DragCompleted">
        <GridSplitter.Style>
          <Style TargetType="GridSplitter">
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cyan}" />
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </GridSplitter.Style>
      </GridSplitter>

      <local:AiSidebarControl Grid.Column="2"
                              x:Name="AiSidebar" />
    </Grid>

    <local:StatusBarControl Grid.Row="2"
                            x:Name="StatusBar"
                            Panel.ZIndex="4"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,18"
                            IsHitTestVisible="False" />

    <local:FindBarControl x:Name="FindBar" />

    <local:DownloadShelfControl Grid.Row="2"
                                x:Name="DownloadShelf"
                                Panel.ZIndex="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,18,54" />

    <Canvas x:Name="TabDragOverlay" Grid.RowSpan="3" IsHitTestVisible="False" />

    <Popup x:Name="SidebarRailPopup"
           Placement="Relative"
           AllowsTransparency="True"
           StaysOpen="True">
      <local:SidebarRailControl x:Name="SidebarRail" />
    </Popup>
    </Grid>

    <Grid x:Name="ResizeGripLayer" Panel.ZIndex="10">
      <Border x:Name="ResizeLeftGrip" Width="12" HorizontalAlignment="Left"
              Background="Transparent" Cursor="SizeWE"
              PreviewMouseLeftButtonDown="ResizeGrip_PreviewMouseLeftButtonDown" />
      <Border x:Name="ResizeRightGrip" Width="12" HorizontalAlignment="Right"
              Background="Transparent" Cursor="SizeWE"
              PreviewMouseLeftButtonDown="ResizeGrip_PreviewMouseLeftButtonDown" />
      <Border x:Name="ResizeTopGrip" Height="12" VerticalAlignment="Top"
              Background="Transparent" Cursor="SizeNS"
              PreviewMouseLeftButtonDown="ResizeGrip_PreviewMouseLeftButtonDown" />
      <Border x:Name="ResizeBottomGrip" Height="12" VerticalAlignment="Bottom"
              Background="Transparent" Cursor="SizeNS"
              PreviewMouseLeftButtonDown="ResizeGrip_PreviewMouseLeftButtonDown" />
      <Border x:Name="ResizeTopLeftGrip" Width="16" Height="16"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Background="Transparent" Cursor="SizeNWSE"
              PreviewMouseLeftButtonDown="ResizeGrip_PreviewMouseLeftButtonDown" />
      <Border x:Name="ResizeTopRightGrip" Width="16" Height="16"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Background="Transparent" Cursor="SizeNESW"
              PreviewMouseLeftButtonDown="ResizeGrip_PreviewMouseLeftButtonDown" />
      <Border x:Name="ResizeBottomLeftGrip" Width="16" Height="16"
              HorizontalAlignment="Left" VerticalAlignment="Bottom"
              Background="Transparent" Cursor="SizeNESW"
              PreviewMouseLeftButtonDown="ResizeGrip_PreviewMouseLeftButtonDown" />
      <Border x:Name="ResizeBottomRightGrip" Width="16" Height="16"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Background="Transparent" Cursor="SizeNWSE"
              PreviewMouseLeftButtonDown="ResizeGrip_PreviewMouseLeftButtonDown" />
    </Grid>
  </Grid>
</Window>
