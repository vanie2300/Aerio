<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="AppBg" Color="#0D0D0D" />
  <SolidColorBrush x:Key="ChromeBg" Color="#141414" />
  <SolidColorBrush x:Key="ChromeAlt" Color="#1A1A1A" />
  <SolidColorBrush x:Key="InputBg" Color="#101010" />
  <SolidColorBrush x:Key="TitleBg" Color="#0A0A0A" />
  <SolidColorBrush x:Key="ButtonBg" Color="#181818" />
  <SolidColorBrush x:Key="ButtonHover" Color="#202020" />
  <SolidColorBrush x:Key="ButtonPressed" Color="#262626" />
  <SolidColorBrush x:Key="Stroke" Color="#2F2F2F" />
  <SolidColorBrush x:Key="SubtleStroke" Color="#1F1F1F" />
  <SolidColorBrush x:Key="Text" Color="#EFEFEF" />
  <SolidColorBrush x:Key="Muted" Color="#8E8E8E" />
  <SolidColorBrush x:Key="Cyan" Color="#724DDF" />
  <SolidColorBrush x:Key="Lime" Color="#6A9955" />
  <SolidColorBrush x:Key="Pink" Color="#C586C0" />
  <SolidColorBrush x:Key="ScrollThumb" Color="#5A5A5A" />
  <SolidColorBrush x:Key="ScrollThumbHover" Color="#7A7A7A" />
  <SolidColorBrush x:Key="ScrollThumbPressed" Color="#999999" />
  <RadialGradientBrush x:Key="StartBg"
                       Center="0.5,0.34"
                       GradientOrigin="0.5,0.34"
                       RadiusX="0.78"
                       RadiusY="0.7">
    <GradientStop Color="#0B0E17" Offset="0" />
    <GradientStop Color="#090C14" Offset="0.55" />
    <GradientStop Color="#07080C" Offset="1" />
  </RadialGradientBrush>

  <DropShadowEffect x:Key="TabGlow" ShadowDepth="0" BlurRadius="12" Opacity="0.3" Color="#724DDF" />
  <DropShadowEffect x:Key="ButtonGlow" ShadowDepth="0" BlurRadius="8" Opacity="0.25" Color="#724DDF" />
  <DropShadowEffect x:Key="PopupShadow" ShadowDepth="0" BlurRadius="24" Opacity="0.35" Color="#000000" />
</ResourceDictionary>
