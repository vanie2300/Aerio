<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      Trusted for exactly one package family: LiquidGlassEngineering.* (used by
      LiquidGlassEngineering.Wpf, pinned to an exact version in the csproj).
      This is a third-party personal feed, not nuget.org - it does not get
      NuGet.org's malware scanning or immutable-id guarantees. Re-review this
      trust decision when bumping the package version, and prefer moving the
      package to nuget.org if it is ever published there.
    -->
    <add key="liquid-glass-engineering" value="https://liquid-glass-engineering.vercel.app/nuget/index.json" />
  </packageSources>
  <!--
    Supply-chain containment: each package ID may only restore from the source
    that explicitly maps it. nuget.org serves everything except the
    LiquidGlassEngineering.* namespace; the personal feed can never inject any
    other package, and a squatted LiquidGlassEngineering.* ID on nuget.org is
    ignored. (NuGet 6.3+; unmapped IDs fail restore with NU1012 rather than
    falling back silently.)
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="liquid-glass-engineering">
      <package pattern="LiquidGlassEngineering.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
